@inject ITeamDataService TeamService

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate-in">
        <div class="bg-surface border border-line2 w-full max-w-md rounded-xl p-5 shadow-xl space-y-4">

            <div class="flex items-center justify-between border-b border-line pb-3">
                <div class="flex items-center gap-2">

                    <h3 class="font-extrabold text-ink text-base">Registrar Gasto de Caja</h3>
                </div>
                <button @onclick="Close" class="w-8 h-8 rounded-full bg-well2 flex items-center justify-center text-muted hover:text-ink">
                    ✕
                </button>
            </div>

            <div class="space-y-3 text-xs">
                <div>
                    <label class="font-bold text-ink2 block mb-1">Concepto del gasto</label>
                    <input @bind="_concept" type="text" placeholder="Ej: Arbitraje Jornada 5, 2 balones de partido..."
                           class="w-full bg-well border border-line2 rounded-lg px-3 py-2.5 text-ink font-medium focus:border-club focus:outline-none" />
                </div>

                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="font-bold text-ink2 block mb-1">Importe (€)</label>
                        <input @bind="_amount" type="number" step="0.50"
                               class="w-full bg-well border border-line2 rounded-lg px-3 py-2 text-ink font-cond font-bold focus:border-club focus:outline-none" />
                    </div>
                    <div>
                        <label class="font-bold text-ink2 block mb-1">Categoría</label>
                        <select @bind="_category" class="w-full bg-well border border-line2 rounded-lg px-3 py-2 text-ink focus:border-club focus:outline-none">
                            <option value="Árbitros">Árbitros</option>
                            <option value="Campos">Alquiler Canchas / Campos</option>
                            <option value="Material">Material / Balones</option>
                            <option value="Tercer Tiempo">Tercer Tiempo </option>
                            <option value="Inscripción">Inscripción Liga</option>
                            <option value="Otros">Otros</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="font-bold text-ink2 block mb-1">Fecha del gasto</label>
                    <input @bind="_expenseDate" type="date"
                               class="w-full bg-well border border-line2 rounded-lg px-3 py-2 text-ink font-medium focus:border-club focus:outline-none" />
                </div>
            </div>

            <div class="flex gap-2 pt-2">
                <button @onclick="Close" class="flex-1 py-2.5 bg-well2 hover:bg-well2 text-ink2 font-bold rounded-lg text-xs transition">
                    Cancelar
                </button>
                <button @onclick="SaveExpense" class="flex-1 py-2.5 bg-club hover:bg-clubdeep text-white font-extrabold rounded-lg text-xs transition">
                    Descontar de Caja
                </button>
            </div>

        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    private string _concept = "Arbitraje Jornada";
    private decimal _amount = 45.00m;
    private string _category = "Árbitros";
    private DateTime _expenseDate = DateTime.Today;

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task SaveExpense()
    {
        if (string.IsNullOrWhiteSpace(_concept) || _amount <= 0) return;

        var expense = new TeamExpense
        {
            Concept = _concept,
            Amount = _amount,
            Category = _category,
            ExpenseDate = _expenseDate
        };

        await TeamService.AddExpenseAsync(expense);
        await Close();
    }
}
