@inject ITeamDataService TeamService

<div class="min-h-screen flex flex-col justify-center items-center p-4 bg-app text-ink">
    <div class="w-full max-w-md bg-surface border border-line rounded-xl p-6 sm:p-8 shadow-xl  relative overflow-hidden">

        <!-- Red/White APN top bar -->
        <div class="absolute top-0 left-0 right-0 h-1.5 apn-stripes"></div>

        <!-- Crest & Header -->
        <div class="text-center mb-6">
            <div class="w-20 h-24 mx-auto mb-3">
                <img src="escudo.png" alt="Escudo Atletic Poblenou" class="w-full h-full object-contain" />
            </div>
            <h1 class="font-cond font-extrabold text-[28px] leading-none tracking-wide text-ink uppercase m-0">Atl&egrave;tic Poblenou</h1>
            <p class="text-[13px] text-muted font-medium mt-1.5">Veteranos · Liga de Barcelona · desde 1929</p>
        </div>

        <!-- Tabs: Iniciar Sesión / Registro -->
        <div class="apn-tabs mb-5">
            <button @onclick='() => _activeAuthTab = "login"' class="apn-tab @(_activeAuthTab == "login" ? "active" : "")">Iniciar sesión</button>
            <button @onclick='() => _activeAuthTab = "register"' class="apn-tab @(_activeAuthTab == "register" ? "active" : "")">Nuevo jugador</button>
        </div>

        <!-- Error / Alert Message -->
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="mb-4 p-3 bg-clubbg border border-club/40 rounded-xl text-xs text-clubtext flex items-center gap-2">
                <span>@_errorMessage</span>
            </div>
        }

        <!-- REACTIVATION BOX FOR DEACTIVATED PLAYERS -->
        @if (_showReactivationBox)
        {
            <div class="mb-5 p-4 bg-red-500/10 border-2 border-red-500/40 rounded-xl space-y-3 animate-in fade-in text-xs">
                <div class="flex items-center gap-2 text-red-500 font-bold text-sm">
                    <span>🚫</span>
                    <span>Cuenta Desvinculada del Equipo</span>
                </div>
                <p class="text-muted leading-relaxed">
                    Has sido dado de baja de la plantilla por el administrador. Para volver a ingresar y reactivar tu ficha, escribe el <strong>código de seguridad</strong> que te envió el capitán/admin:
                </p>
                <div>
                    <label class="font-bold text-ink2 block mb-1">Código Secreto del Club</label>
                    <input @bind="_reactivationCode" type="text" placeholder="Ej: APN-XXXX"
                           class="w-full bg-well border border-line2 rounded-lg px-3 py-2 text-ink font-cond font-bold uppercase tracking-wider focus:border-club focus:outline-none" />
                </div>
                @if (!string.IsNullOrEmpty(_reactivationError))
                {
                    <div class="text-xs text-club font-bold">@_reactivationError</div>
                }
                <div class="flex gap-2 pt-1">
                    <button type="button" @onclick="() => _showReactivationBox = false"
                            class="flex-1 py-2 bg-well hover:bg-well2 text-ink font-bold rounded-lg transition">
                        Volver
                    </button>
                    <button type="button" @onclick="HandleReactivate"
                            class="flex-1 py-2 bg-ok hover:bg-okdeep text-white font-extrabold rounded-lg transition flex items-center justify-center gap-1 shadow-sm">
                        <span>✓</span>
                        <span>Reactivar y Entrar</span>
                    </button>
                </div>
            </div>
        }

        @if (_activeAuthTab == "login")
        {
            <!-- LOGIN FORM -->
            <form @onsubmit="HandleLogin" class="space-y-3.5 text-xs">
                <div>
                    <label class="font-bold text-ink2 block mb-1">Email o Apodo</label>
                    <input @bind="_loginModel.EmailOrNickname" type="text" placeholder="Ej: pitu1386 o tu@email.com"
                           class="w-full bg-well border border-line2 rounded-lg px-3.5 py-2.5 text-ink font-medium focus:border-club focus:outline-none" />
                </div>

                <div>
                    <div class="flex items-center justify-between mb-1">
                        <label class="font-bold text-ink2">Contraseña</label>
                        <span class="text-xs text-faint">Demo: 1234</span>
                    </div>
                    <input @bind="_loginModel.Password" type="password" placeholder="Tu contraseña"
                           class="w-full bg-well border border-line2 rounded-lg px-3.5 py-2.5 text-ink font-medium focus:border-club focus:outline-none" />
                </div>

                <button type="submit"
                        class="w-full py-3 bg-club hover:bg-clubdeep text-white font-extrabold text-sm rounded-lg transition flex items-center justify-center gap-2 mt-2">
                    <span>Ingresar al Club</span>
                    <span>→</span>
                </button>
            </form>

            <!-- Demo Quick-Access Profiles (Ocultable para producción) -->
            @if (TeamService.GetClubSettings().ShowDemoShortcuts)
            {
                <div class="mt-6 pt-4 border-t border-line">
                    <div class="text-xs uppercase tracking-wider font-bold text-muted mb-2 text-center">
                        Acceso rápido de prueba (1 toque):
                    </div>
                    <div class="grid grid-cols-3 gap-1.5 text-xs">
                        <button @onclick='() => QuickLogin("user-1")'
                                class="p-2 bg-well hover:bg-well2 border border-line rounded-lg text-center transition">
                            <div class="font-extrabold text-warntext">pitu1386</div>
                            <div class="text-[11px] text-faint">Admin</div>
                        </button>
                        <button @onclick='() => QuickLogin("user-2")'
                                class="p-2 bg-well hover:bg-well2 border border-line rounded-lg text-center transition">
                            <div class="font-extrabold text-oktext">Carles</div>
                            <div class="text-[11px] text-faint">Tesorero</div>
                        </button>
                        <button @onclick='() => QuickLogin("user-3")'
                                class="p-2 bg-well hover:bg-well2 border border-line rounded-lg text-center transition">
                            <div class="font-extrabold text-ink">Marc</div>
                            <div class="text-[11px] text-faint">Arquero</div>
                        </button>
                    </div>
                </div>
            }
        }
        else
        {
            <!-- REGISTER FORM (CON VALIDACIÓN DE CÓDIGO DE EQUIPO) -->
            <form @onsubmit="HandleRegister" class="space-y-3 text-xs max-h-[60vh] overflow-y-auto pr-1">

                <!-- Anti-Intruder Team Secret Code -->
                <div class="bg-warnbg border border-warn/40 p-3 rounded-xl">
                    <label class="font-bold text-warntext block mb-0.5 flex items-center gap-1">
                        Código Secreto de Registro
                    </label>
                    <p class="text-xs text-muted mb-2">Pídele el código actual al capitán/admin para validar tu ingreso al club.</p>
                    <input @bind="_registerModel.TeamCode" type="text" placeholder="Ej: APN-XXXX"
                           class="w-full bg-well border border-warn/40 rounded-lg px-3 py-2 text-warntext font-cond font-extrabold uppercase tracking-wider focus:outline-none" />
                </div>

                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="font-bold text-ink2 block mb-1">Nombre y Apellido</label>
                        <input @bind="_registerModel.FullName" type="text" placeholder="Ej: Lionel Messi"
                               class="w-full bg-well border border-line2 rounded-lg px-3 py-2 text-ink font-medium focus:border-club focus:outline-none" />
                    </div>
                    <div>
                        <label class="font-bold text-ink2 block mb-1">Apodo en el equipo</label>
                        <input @bind="_registerModel.Nickname" type="text" placeholder="Ej: Leo"
                               class="w-full bg-well border border-line2 rounded-lg px-3 py-2 text-ink font-medium focus:border-club focus:outline-none" />
                    </div>
                </div>

                <div>
                    <label class="font-bold text-ink2 block mb-1">Email</label>
                    <input @bind="_registerModel.Email" type="email" placeholder="tu@email.com"
                           class="w-full bg-well border border-line2 rounded-lg px-3 py-2 text-ink font-medium focus:border-club focus:outline-none" />
                </div>

                <div>
                    <label class="font-bold text-ink2 block mb-1">Contraseña</label>
                    <input @bind="_registerModel.Password" type="password" placeholder="Mínimo 4 caracteres"
                           class="w-full bg-well border border-line2 rounded-lg px-3 py-2 text-ink font-medium focus:border-club focus:outline-none" />
                </div>

                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="font-bold text-ink2 block mb-1">Posición</label>
                        <select @bind="_registerModel.Position" class="w-full bg-well border border-line2 rounded-lg px-3 py-2 text-ink focus:border-club focus:outline-none">
                            <option value="@Position.Portero">Arquero / Portero</option>
                            <option value="@Position.Defensa">Defensa</option>
                            <option value="@Position.Centrocampista">Mediocampista</option>
                            <option value="@Position.Delantero">Delantero</option>
                        </select>
                    </div>
                    <div>
                        <label class="font-bold text-ink2 block mb-1">Pie Hábil</label>
                        <select @bind="_registerModel.Foot" class="w-full bg-well border border-line2 rounded-lg px-3 py-2 text-ink focus:border-club focus:outline-none">
                            <option value="@DominantFoot.Diestro">Diestro</option>
                            <option value="@DominantFoot.Zurdo">Zurdo</option>
                            <option value="@DominantFoot.Ambidiestro">Ambidiestro</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="font-bold text-ink2 block mb-1">Dorsal (#)</label>
                        <input @bind="_registerModel.JerseyNumber" type="number" min="1" max="99" placeholder="Ej: 10"
                               class="w-full bg-well border border-line2 rounded-lg px-3 py-2 text-ink font-cond font-bold focus:border-club focus:outline-none" />
                    </div>
                    <div>
                        <label class="font-bold text-ink2 block mb-1">Teléfono (WhatsApp)</label>
                        <input @bind="_registerModel.Phone" type="tel" placeholder="+34 600 00 00 00"
                               class="w-full bg-well border border-line2 rounded-lg px-3 py-2 text-ink font-medium focus:border-club focus:outline-none" />
                    </div>
                </div>

                <div>
                    <label class="font-bold text-ink2 block mb-1">Fecha de Nacimiento</label>
                    <input @bind="_registerModel.BirthDate" type="date"
                           class="w-full bg-well border border-line2 rounded-lg px-3 py-2 text-ink font-medium focus:border-club focus:outline-none" />
                </div>

                <button type="submit"
                        class="w-full py-3 bg-club hover:bg-clubdeep text-white font-extrabold text-sm rounded-lg transition flex items-center justify-center gap-2 mt-3">
                    <span>Crear Mi Ficha y Entrar</span>
                    <span>✓</span>
                </button>
            </form>
        }

    </div>
</div>

@code {
    private string _activeAuthTab = "login";
    private string _errorMessage = "";
    private bool _showReactivationBox = false;
    private string _reactivationCode = "";
    private string _reactivationError = "";

    private LoginModel _loginModel = new() { EmailOrNickname = "dani@atleticpoblenou.cat", Password = "1234" };
    private RegisterModel _registerModel = new() { TeamCode = "", Position = Position.Centrocampista, Foot = DominantFoot.Diestro };

    private async Task HandleLogin()
    {
        _errorMessage = "";
        _showReactivationBox = false;
        var result = await TeamService.LoginAsync(_loginModel.EmailOrNickname, _loginModel.Password);
        if (!result.Success)
        {
            if (result.ErrorMessage == "DEACTIVATED_NEEDS_CODE")
            {
                _showReactivationBox = true;
                _reactivationError = "";
            }
            else
            {
                _errorMessage = result.ErrorMessage;
            }
        }
    }

    private async Task HandleReactivate()
    {
        _reactivationError = "";
        var result = await TeamService.ReactivateWithCodeAsync(_loginModel.EmailOrNickname, _loginModel.Password, _reactivationCode);
        if (!result.Success)
        {
            _reactivationError = result.ErrorMessage;
        }
        else
        {
            _showReactivationBox = false;
        }
    }

    private async Task HandleRegister()
    {
        _errorMessage = "";
        var result = await TeamService.RegisterAsync(_registerModel);
        if (!result.Success)
        {
            _errorMessage = result.ErrorMessage;
        }
    }

    private async Task QuickLogin(string userId)
    {
        await TeamService.SetCurrentUserIdAsync(userId);
    }
}

