@inject ITeamDataService TeamService

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate-in">
        <div class="bg-surface border border-line2 w-full max-w-lg rounded-xl p-5 space-y-4 max-h-[90vh] overflow-y-auto">

            <div class="flex items-center justify-between border-b border-line pb-3">
                <div>
                    <h3 class="font-extrabold text-ink text-base">Nube del club (Supabase)</h3>
                    <p class="text-xs text-infotext">Estado de conexión y sincronización</p>
                </div>
                <button @onclick="Close" class="w-8 h-8 rounded-full bg-well2 flex items-center justify-center text-muted hover:text-ink">✕</button>
            </div>

            <div class="grid grid-cols-2 gap-2 text-xs">
                <div class="bg-well p-3 rounded-lg border border-line">
                    <div class="text-muted font-medium">Base de datos</div>
                    <div class="font-bold mt-0.5 flex items-center gap-1.5 @(TeamService.IsCloudConnected ? "text-oktext" : "text-clubtext")">
                        <span class="w-2 h-2 rounded-full @(TeamService.IsCloudConnected ? "bg-ok" : "bg-club")"></span>
                        @(TeamService.IsCloudConnected ? "Conectada" : "Sin conexión")
                    </div>
                </div>
                <div class="bg-well p-3 rounded-lg border border-line">
                    <div class="text-muted font-medium">Tiempo real</div>
                    <div class="font-bold mt-0.5 flex items-center gap-1.5 @(TeamService.IsRealtimeConnected ? "text-oktext" : "text-warntext")">
                        <span class="w-2 h-2 rounded-full @(TeamService.IsRealtimeConnected ? "bg-ok animate-pulse" : "bg-warn")"></span>
                        @(TeamService.IsRealtimeConnected ? "Suscrito" : "No conectado")
                    </div>
                </div>
                <div class="bg-well p-3 rounded-lg border border-line col-span-2">
                    <div class="text-muted font-medium">Última sincronización</div>
                    <div class="font-bold text-ink font-cond mt-0.5">
                        @(TeamService.LastSyncUtc.HasValue ? TeamService.LastSyncUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") : "Nunca")
                    </div>
                </div>
                <div class="bg-well p-3 rounded-lg border border-line col-span-2">
                    <div class="text-muted font-medium">Sesión</div>
                    <div class="font-bold text-ink font-cond mt-0.5 truncate">@TeamService.SessionEmail</div>
                </div>
                <div class="bg-well p-3 rounded-lg border border-line col-span-2">
                    <div class="text-muted font-medium">Proyecto</div>
                    <div class="font-bold text-ink font-cond mt-0.5 truncate">@AppInfo.SupabaseUrl</div>
                </div>
            </div>

            <div class="p-3 bg-well rounded-xl border border-line text-xs text-muted space-y-1.5">
                <div class="font-bold text-ink">Cómo funciona</div>
                <p>Cada cambio se escribe en Supabase y, si la nube lo acepta, se vuelve a leer esa tabla. Si lo rechaza, verás un aviso rojo y el dato vuelve a su estado anterior.</p>
                <p>Los cambios de otros dispositivos llegan por Realtime. Si "Tiempo real" no está suscrito, los datos se refrescan al volver a abrir la app o con el botón de abajo.</p>
                <p>Permisos por rol aplicados en el servidor (RLS): <code>migracion_auth_rls.sql</code> en el repositorio.</p>
            </div>

            <div class="flex gap-2 pt-2">
                <button @onclick="Refresh" disabled="@_refreshing" class="flex-1 py-2.5 bg-club hover:bg-clubdeep text-white font-extrabold rounded-lg text-xs transition disabled:opacity-60">
                    @(_refreshing ? "Sincronizando..." : "Sincronizar ahora")
                </button>
                <button @onclick="Close" class="flex-1 py-2.5 bg-well2 hover:bg-well2 text-ink font-bold rounded-lg text-xs transition">
                    Cerrar
                </button>
            </div>

        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    private bool _refreshing;

    private async Task Refresh()
    {
        _refreshing = true;
        try { await TeamService.RefreshFromCloudAsync(); }
        finally { _refreshing = false; }
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}
