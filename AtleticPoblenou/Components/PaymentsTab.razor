@inject ITeamDataService TeamService
@inject IJSRuntime JS

<div class="space-y-4 pb-20">

    <!-- TREASURY BALANCE HERO CARD -->
    @{
        var totalIn = TeamService.GetPayments().Where(p => p.Status == PaymentStatus.Paid).Sum(p => p.Amount);
        var totalOut = TeamService.GetExpenses().Sum(e => e.Amount);
    }
    <div class="bg-hero text-herotext border border-heroline rounded-xl px-[18px] pt-4 pb-4 space-y-3">
        <div class="flex items-center justify-between">
            <div class="text-[11px] font-bold tracking-[0.1em] uppercase text-heroclub">Caja del club</div>
            <div class="text-xs font-medium text-heromuted">A.P.N. Veteranos</div>
        </div>

        <div class="font-cond font-extrabold text-[46px] leading-none tracking-tight">
            @TeamService.GetTeamBalance().ToString("N2") €
        </div>

        <div class="grid grid-cols-2 gap-2.5 pt-3 border-t border-heroline">
            <div>
                <div class="text-xs font-medium text-heromuted">Recaudado</div>
                <div class="font-cond font-bold text-[22px] leading-tight text-herook">+@totalIn.ToString("N2") €</div>
            </div>
            <div>
                <div class="text-xs font-medium text-heromuted">Gastos</div>
                <div class="font-cond font-bold text-[22px] leading-tight text-heroclub">−@totalOut.ToString("N2") €</div>
            </div>
        </div>

        @if (IsAdmin)
        {
            <div class="grid grid-cols-2 gap-2">
                <button @onclick="() => OnOpenDirectPayment.InvokeAsync(null)"
                        class="h-11 rounded-[10px] bg-club hover:bg-clubdeep text-white text-sm font-bold transition">
                    Registrar cobro
                </button>
                <button @onclick="OnAddExpense"
                        class="h-11 rounded-[10px] border border-heroline2 text-herotext text-sm font-semibold hover:bg-heroline/40 transition">
                    Añadir gasto
                </button>
            </div>
        }
        else
        {
            <div class="text-[13px] text-heromuted">¿Hiciste un pago por Bizum? El tesorero lo cargará al recibirlo.</div>
        }

        <!-- SHARE TREASURY SUMMARY VIA WHATSAPP -->
        <button type="button" @onclick="ShareTreasuryWhatsApp"
                class="w-full h-10 rounded-[10px] bg-ok hover:bg-okdeep text-white text-xs font-extrabold transition flex items-center justify-center gap-2 shadow-sm">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.5 8.5 0 0 1-12.6 7.4L3 21l2.1-5.4A8.5 8.5 0 1 1 21 11.5z"></path></svg>
            <span>Compartir Balance de Caja por WhatsApp</span>
        </button>
    </div>

    <!-- VIEW SELECTOR TABS -->
    <div class="apn-tabs">
        <button @onclick='() => _subTab = "players"' class="apn-tab @(_subTab == "players" ? "active" : "")">Aportes</button>
        <button @onclick='() => _subTab = "history"' class="apn-tab @(_subTab == "history" ? "active" : "")">Historial</button>
        <button @onclick='() => _subTab = "expenses"' class="apn-tab @(_subTab == "expenses" ? "active" : "")">Gastos</button>
    </div>
    <!-- SUB-TAB 1: APORTES POR JUGADOR (TRANSPARENCIA TOTAL: CADA UNO VE LO QUE PAGÓ CADA COMPAÑERO) -->
    @if (_subTab == "players")
    {
        var allPaidPayments = TeamService.GetPayments().Where(p => p.Status == PaymentStatus.Paid).ToList();
        var profiles = TeamService.GetProfiles();
        var clubSettings = TeamService.GetClubSettings();
        var seasonFee = clubSettings.SeasonFeePerPlayer;

        <div class="space-y-3">
            <!-- Costo de Temporada Header Banner -->
            <div class="bg-well p-3.5 rounded-xl border border-line flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <div class="flex items-center gap-2.5">

                    <div>
                        <div class="text-xs text-muted font-bold uppercase tracking-wider">Costo Inicial de Temporada</div>
                        <div class="text-sm font-extrabold text-ink flex items-center gap-2">
                            <span>@seasonFee.ToString("N0") € por jugador</span>
                            <span class="text-xs font-normal text-faint font-cond">(Cuota Anual)</span>
                        </div>
                    </div>
                </div>

                <div class="text-xs text-muted self-end sm:self-auto font-cond">
                    Total cubierto: <strong class="text-oktext">@allPaidPayments.Sum(p => p.Amount).ToString("N0") €</strong> / @((seasonFee * profiles.Count).ToString("N0")) €
                </div>
            </div>

            <div class="flex items-center justify-between text-xs text-muted px-1">
                <span>Estado de aportes por jugador:</span>
                <span class="text-xs text-faint">Toca para ver el desglose</span>
            </div>

            <div class="space-y-2">
                @foreach (var player in profiles)
                {
                    var playerPayments = allPaidPayments.Where(p => p.PlayerId == player.Id).OrderByDescending(p => p.PaidAt).ToList();
                    var totalPaidByPlayer = playerPayments.Sum(p => p.Amount);
                    var percent = seasonFee > 0 ? (int)Math.Min(100, Math.Round((double)totalPaidByPlayer / (double)seasonFee * 100)) : 100;
                    var remaining = Math.Max(0, seasonFee - totalPaidByPlayer);
                    var isSeasonComplete = totalPaidByPlayer >= seasonFee;
                    var isExpanded = _expandedPlayerId == player.Id;

                    <div class="bg-surface border border-line rounded-xl overflow-hidden transition hover:border-line2">
                        <!-- Player Row Header -->
                        <div @onclick="() => TogglePlayerDetail(player.Id)"
                             class="p-3.5 cursor-pointer select-none">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-3">
                                    <span class="w-8 h-8 rounded-full bg-well2 border border-line2 flex items-center justify-center text-xs font-cond font-extrabold text-ink2 shrink-0">
                                        @(player.JerseyNumber?.ToString() ?? "-")
                                    </span>
                                    <div>
                                        <div class="font-bold text-sm text-ink flex items-center gap-1.5">
                                            <span>@player.FullName</span>
                                            @if (player.Id == CurrentUser.Id)
                                            {
                                                <span class="text-[11px] font-bold px-1.5 py-0.2 rounded bg-well2 text-muted border border-line2">TÚ</span>
                                            }
                                            @if (isSeasonComplete)
                                            {
                                                <span class="text-[11px] font-extrabold px-1.5 py-0.2 rounded bg-okbg text-oktext border border-ok/40">
                                                    ✓ CUBIERTO
                                                </span>
                                            }
                                        </div>
                                        <div class="text-xs text-muted">
                                            @player.Nickname • @player.Position
                                        </div>
                                    </div>
                                </div>

                                <div class="flex items-center gap-2.5">
                                    <div class="text-right">
                                        <div class="font-cond font-extrabold text-sm text-oktext">
                                            @totalPaidByPlayer.ToString("N0") €
                                        </div>
                                        <div class="text-xs font-medium @(isSeasonComplete ? "text-oktext" : "text-warntext")">
                                            @(isSeasonComplete ? "Temporada al día" : $"Faltan {remaining:N0} €")
                                        </div>
                                    </div>

                                    <span class="text-faint text-xs font-bold transition-transform @(isExpanded ? "rotate-90 text-ink" : "")">
                                        ›
                                    </span>
                                </div>
                            </div>

                            <!-- Progress Bar for Season Fee -->
                            <div class="mt-2.5 flex items-center gap-2">
                                <div class="flex-1 bg-well rounded-full h-1.5 overflow-hidden border border-line">
                                    <div class="h-full @(isSeasonComplete ? "bg-ok" : "bg-warn") transition-all duration-300" style="width: @percent%"></div>
                                </div>
                                <span class="text-xs font-cond text-muted font-bold shrink-0">@percent%</span>
                            </div>
                        </div>

                        <!-- Expanded Payments Detail for this Player -->
                        @if (isExpanded)
                        {
                            <div class="p-3 bg-well border-t border-line space-y-2 text-xs">
                                <div class="flex items-center justify-between text-xs font-bold text-muted px-1">
                                    <span>Detalle de pagos recibidos:</span>
                                    @if (IsAdmin)
                                    {
                                        <button @onclick="() => OnOpenDirectPayment.InvokeAsync(player.Id)"
                                                class="text-xs font-extrabold text-oktext hover:text-ok flex items-center gap-1">
                                            <span>+</span> Cargar pago a este jugador
                                        </button>
                                    }
                                </div>

                                @if (!playerPayments.Any())
                                {
                                    <div class="p-3 text-center text-faint text-xs italic bg-surface rounded-lg">
                                        Aún no tiene pagos registrados por el tesorero.
                                    </div>
                                }
                                else
                                {
                                    <div class="space-y-1.5">
                                        @foreach (var p in playerPayments)
                                        {
                                            <div class="p-2 bg-surface border border-line rounded-lg flex items-center justify-between text-xs">
                                                <div>
                                                    <div class="font-bold text-ink text-xs">@p.Concept</div>
                                                    <div class="text-xs text-muted flex items-center gap-1">
                                                        <span>@(p.PaidAt?.ToString("dd/MM/yyyy") ?? "-")</span>
                                                        <span>•</span>
                                                        <span class="text-oktext font-medium">@p.Method</span>
                                                        @if (!string.IsNullOrEmpty(p.Notes))
                                                        {
                                                            <span>• "@p.Notes"</span>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="font-cond font-extrabold text-xs text-ink">
                                                    +@p.Amount.ToString("N2") €
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    <!-- SUB-TAB 2: HISTORIAL CRONOLÓGICO DE COBROS RECIBIDOS -->
    @if (_subTab == "history")
    {
        var allPayments = TeamService.GetPayments().Where(p => p.Status == PaymentStatus.Paid).OrderByDescending(p => p.PaidAt).ToList();

        <div class="space-y-2">
            <div class="flex items-center justify-between text-xs text-muted px-1">
                <span>Cobros asentados por el tesorero:</span>
                <span class="font-bold text-ink">@allPayments.Count recibidos</span>
            </div>

            @if (!allPayments.Any())
            {
                <div class="p-6 bg-surface border border-line rounded-xl text-center text-faint text-xs">
                    No hay cobros registrados todavía.
                </div>
            }
            else
            {
                <div class="space-y-2">
                    @foreach (var pay in allPayments)
                    {
                        var player = TeamService.GetProfiles().FirstOrDefault(p => p.Id == pay.PlayerId);

                        <div class="bg-surface border border-line rounded-xl p-3 flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-lg bg-okbg border border-ok/40 flex items-center justify-center font-bold text-xs text-oktext shrink-0">
                                    ✓
                                </div>
                                <div>
                                    <div class="font-bold text-sm text-ink">
                                        @player?.Nickname
                                        <span class="font-normal text-xs text-muted">(@player?.FullName)</span>
                                    </div>
                                    <div class="text-xs text-muted">
                                        @pay.Concept • @(pay.PaidAt?.ToString("dd/MM/yyyy") ?? "") • Vía <span class="text-ink2 font-semibold">@pay.Method</span>
                                    </div>
                                </div>
                            </div>

                            <div class="text-right">
                                <div class="font-cond font-extrabold text-sm text-oktext">
                                    +@pay.Amount.ToString("N2") €
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }

    <!-- SUB-TAB 3: GASTOS DE CAJA -->
    @if (_subTab == "expenses")
    {
        var expenses = TeamService.GetExpenses();

        <div class="space-y-2">
            <div class="flex items-center justify-between text-xs text-muted px-1">
                <span>Salidas de caja del equipo:</span>
                <span class="font-bold text-ink">@expenses.Count gastos</span>
            </div>

            <div class="space-y-2">
                @foreach (var exp in expenses)
                {
                    <div class="bg-surface border border-line rounded-xl p-3.5 flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-lg bg-well2 border border-line2 flex items-center justify-center text-sm shrink-0">
                                @(exp.Category == "Árbitros"? "": exp.Category == "Material"? "": "")
                            </div>
                            <div>
                                <div class="font-bold text-sm text-ink">@exp.Concept</div>
                                <div class="text-xs text-muted">
                                    @exp.ExpenseDate.ToString("dd/MM/yyyy") • @exp.Category
                                </div>
                            </div>
                        </div>

                        <div class="font-extrabold text-sm font-cond text-clubtext">
                            -@exp.Amount.ToString("N2") €
                        </div>
                    </div>
                }
            </div>
        </div>
    }

</div>

@code {
    [Parameter] public EventCallback<string?> OnOpenDirectPayment { get; set; }
    [Parameter] public EventCallback OnAddExpense { get; set; }

    private string _subTab = "players"; // "players", "history", "expenses"
    private string? _expandedPlayerId = null;

    private UserProfile CurrentUser => TeamService.GetCurrentUser();
    private bool IsAdmin => CurrentUser.Role == UserRole.Admin || CurrentUser.Role == UserRole.Treasurer;

    private void TogglePlayerDetail(string playerId)
    {
        if (_expandedPlayerId == playerId)
            _expandedPlayerId = null;
        else
            _expandedPlayerId = playerId;
    }

    private async Task ShareTreasuryWhatsApp()
    {
        var balance = TeamService.GetTeamBalance();
        var totalIn = TeamService.GetPayments().Where(p => p.Status == PaymentStatus.Paid).Sum(p => p.Amount);
        var totalOut = TeamService.GetExpenses().Sum(e => e.Amount);
        var fee = TeamService.GetClubSettings().SeasonFeePerPlayer;
        var profiles = TeamService.GetProfiles();
        var allPayments = TeamService.GetPayments().Where(p => p.Status == PaymentStatus.Paid).ToList();

        var fullyPaidCount = profiles.Count(p => allPayments.Where(x => x.PlayerId == p.Id).Sum(x => x.Amount) >= fee);
        var totalSeasonTarget = fee * profiles.Count;
        var percentCollected = totalSeasonTarget > 0 ? Math.Round(100.0m * totalIn / totalSeasonTarget, 1) : 0;

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("💶 *BALANCE DE CAJA · ATLÈTIC POBLENOU*");
        sb.AppendLine($"📅 *Informe al:* {DateTime.Now:dd/MM/yyyy}");
        sb.AppendLine();
        sb.AppendLine($"💰 *Saldo Disponible:* {balance:N2} €");
        sb.AppendLine($"📥 *Total Recaudado:* +{totalIn:N2} €");
        sb.AppendLine($"📤 *Total Gastos de Caja:* −{totalOut:N2} €");
        sb.AppendLine();
        sb.AppendLine($"🎯 *Cuota Temporada ({fee:N0} €/jugador):*");
        sb.AppendLine($"• {fullyPaidCount} de {profiles.Count} jugadores con cuota completa");
        sb.AppendLine($"• Progreso anual: {percentCollected}% cubierto");
        sb.AppendLine();
        sb.AppendLine("📋 *Transparencia total:* Cada compañero puede consultar sus recibos individuales en la app.");
        sb.AppendLine("🔴⚪ *¡Força Poblenou!*");

        var text = sb.ToString();
        var url = $"https://wa.me/?text={Uri.EscapeDataString(text)}";
        await JS.InvokeVoidAsync("open", url, "_blank");
    }
}
