@inject ITeamDataService TeamService
@inject IJSRuntime JS

<div class="space-y-4 pb-20">

    <!-- TREASURY BALANCE HERO CARD -->
    @{
        var totalIn = TeamService.GetPayments().Where(p => p.Status == PaymentStatus.Paid).Sum(p => p.Amount);
        var totalOut = TeamService.GetExpenses().Sum(e => e.Amount);
    }
    <div class="bg-hero text-herotext border border-heroline rounded-xl px-[18px] pt-4 pb-4 space-y-3">
        <div class="flex items-center justify-between">
            <div class="text-[11px] font-bold tracking-[0.1em] uppercase text-heroclub">Caja del club</div>
            <div class="text-xs font-medium text-heromuted">A.P.N. Veteranos</div>
        </div>

        <div class="font-cond font-extrabold text-[46px] leading-none tracking-tight">
            @TeamService.GetTeamBalance().ToString("N2") €
        </div>

        <div class="grid grid-cols-2 gap-2.5 pt-3 border-t border-heroline">
            <div>
                <div class="text-xs font-medium text-heromuted">Recaudado</div>
                <div class="font-cond font-bold text-[22px] leading-tight text-herook">+@totalIn.ToString("N2") €</div>
            </div>
            <div>
                <div class="text-xs font-medium text-heromuted">Gastos</div>
                <div class="font-cond font-bold text-[22px] leading-tight text-heroclub">−@totalOut.ToString("N2") €</div>
            </div>
        </div>

        @if (IsAdmin)
        {
            <div class="grid grid-cols-2 gap-2">
                <button @onclick="() => OnOpenDirectPayment.InvokeAsync(null)"
                        class="h-11 rounded-[10px] bg-club hover:bg-clubdeep text-white text-sm font-bold transition">
                    Registrar cobro
                </button>
                <button @onclick="OnAddExpense"
                        class="h-11 rounded-[10px] border border-heroline2 text-herotext text-sm font-semibold hover:bg-heroline/40 transition">
                    Añadir gasto
                </button>
            </div>
        }
        else
        {
            <div class="text-[13px] text-heromuted">¿Hiciste un pago por Bizum? El tesorero lo cargará al recibirlo.</div>
        }

        <!-- SHARE VIA WHATSAPP (solo admin/tesorero: es quien decide qué comunicar al grupo) -->
        @if (IsAdmin)
        {
            <div class="space-y-1.5">
                <button type="button" @onclick="ShareTreasuryWhatsApp"
                        class="w-full h-10 rounded-[10px] bg-ok hover:bg-okdeep text-white text-xs font-extrabold transition flex items-center justify-center gap-2 shadow-sm">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.5 8.5 0 0 1-12.6 7.4L3 21l2.1-5.4A8.5 8.5 0 1 1 21 11.5z"></path></svg>
                    <span>Compartir Balance de Caja por WhatsApp</span>
                </button>
                <button type="button" @onclick="SharePlayerContributionsWhatsApp"
                        class="w-full h-10 rounded-[10px] bg-ok hover:bg-okdeep text-white text-xs font-extrabold transition flex items-center justify-center gap-2 shadow-sm">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.5 8.5 0 0 1-12.6 7.4L3 21l2.1-5.4A8.5 8.5 0 1 1 21 11.5z"></path></svg>
                    <span>Compartir Aportes por Jugador por WhatsApp</span>
                </button>
                <button type="button" @onclick="ShareCajaWhatsApp"
                        class="w-full h-10 rounded-[10px] bg-ok hover:bg-okdeep text-white text-xs font-extrabold transition flex items-center justify-center gap-2 shadow-sm">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.5 8.5 0 0 1-12.6 7.4L3 21l2.1-5.4A8.5 8.5 0 1 1 21 11.5z"></path></svg>
                    <span>Compartir Caja (Recibido y Pagado) por WhatsApp</span>
                </button>
            </div>
        }
    </div>

    <!-- VIEW SELECTOR TABS -->
    <div class="apn-tabs">
        <button @onclick='() => _subTab = "players"' class="apn-tab @(_subTab == "players" ? "active" : "")">Aportes</button>
        <button @onclick='() => _subTab = "history"' class="apn-tab @(_subTab == "history" ? "active" : "")">Historial</button>
        <button @onclick='() => _subTab = "expenses"' class="apn-tab @(_subTab == "expenses" ? "active" : "")">Gastos</button>
        <button @onclick='() => _subTab = "budget"' class="apn-tab @(_subTab == "budget" ? "active" : "")">Presupuesto</button>
    </div>
    <!-- SUB-TAB 1: APORTES POR JUGADOR (TRANSPARENCIA TOTAL: CADA UNO VE LO QUE PAGÓ CADA COMPAÑERO) -->
    @if (_subTab == "players")
    {
        var allPaidPayments = TeamService.GetPayments().Where(p => p.Status == PaymentStatus.Paid).ToList();
        var profiles = TeamService.GetProfiles().Where(p => p.CountsForSeasonFee).ToList();
        var clubSettings = TeamService.GetClubSettings();
        var seasonFee = clubSettings.SeasonFeePerPlayer;

        <div class="space-y-3">
            <!-- Costo de Temporada Header Banner -->
            <div class="bg-well p-3.5 rounded-xl border border-line flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <div class="flex items-center gap-2.5">

                    <div>
                        <div class="text-xs text-muted font-bold uppercase tracking-wider">Costo Inicial de Temporada</div>
                        <div class="text-sm font-extrabold text-ink flex items-center gap-2">
                            <span>@seasonFee.ToString("N0") € por jugador</span>
                            <span class="text-xs font-normal text-faint font-cond">(Cuota Anual)</span>
                        </div>
                    </div>
                </div>

                <div class="text-xs text-muted self-end sm:self-auto font-cond">
                    Total cubierto: <strong class="text-oktext">@allPaidPayments.Where(p => p.IsPlayerPayment).Sum(p => p.Amount).ToString("N0") €</strong> / @((seasonFee * profiles.Count).ToString("N0")) €
                </div>
            </div>

            <!-- Otros Ingresos del Club (remanente, patrocinios, rifas...) -->
            @{
                var otherIncome = allPaidPayments.Where(p => !p.IsPlayerPayment).OrderByDescending(p => p.PaidAt).ToList();
            }
            <div class="bg-surface border border-line rounded-xl p-3.5 space-y-2">
                <div class="flex items-center justify-between">
                    <div class="text-xs font-bold uppercase tracking-wider text-ink2">💰 Otros Ingresos del Club</div>
                    <div class="flex items-center gap-2">
                        <span class="font-cond font-extrabold text-sm text-oktext">@otherIncome.Sum(p => p.Amount).ToString("N0") €</span>
                        @if (IsAdmin)
                        {
                            <button type="button" @onclick="() => OnOpenDirectPayment.InvokeAsync(null)"
                                    class="text-xs font-extrabold text-oktext hover:text-ok flex items-center gap-1">
                                <span>+</span> Cargar
                            </button>
                        }
                    </div>
                </div>
                @if (!otherIncome.Any())
                {
                    <p class="text-[11px] text-faint m-0">Remanente de temporadas anteriores, patrocinios o rifas: se cargan acá, aparte de las cuotas de los jugadores.</p>
                }
                else
                {
                    <div class="space-y-1.5">
                        @foreach (var inc in otherIncome)
                        {
                            <div class="flex items-center justify-between text-xs bg-well px-2.5 py-1.5 rounded-lg">
                                <div>
                                    <div class="font-bold text-ink">@inc.Category</div>
                                    <div class="text-faint">@inc.Concept • @(inc.PaidAt?.ToString("dd/MM/yyyy") ?? "")</div>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="font-extrabold text-oktext font-cond">+@inc.Amount.ToString("N0") €</span>
                                    @if (IsAdmin)
                                    {
                                        <button type="button" @onclick="() => OnEditPayment.InvokeAsync(inc)"
                                                class="text-faint hover:text-ink p-0.5" title="Editar ingreso">
                                            ✎
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="flex items-center justify-between text-xs text-muted px-1">
                <span>Estado de aportes por jugador:</span>
                <span class="text-xs text-faint">Toca para ver el desglose</span>
            </div>

            <div class="space-y-2">
                @foreach (var player in profiles)
                {
                    var playerPayments = allPaidPayments.Where(p => p.PlayerId == player.Id).OrderByDescending(p => p.PaidAt).ToList();
                    var totalPaidByPlayer = playerPayments.Sum(p => p.Amount);
                    var percent = seasonFee > 0 ? (int)Math.Min(100, Math.Round((double)totalPaidByPlayer / (double)seasonFee * 100)) : 100;
                    var remaining = Math.Max(0, seasonFee - totalPaidByPlayer);
                    var isSeasonComplete = totalPaidByPlayer >= seasonFee;
                    var isExpanded = _expandedPlayerId == player.Id;

                    <div class="bg-surface border border-line rounded-xl overflow-hidden transition hover:border-line2">
                        <!-- Player Row Header -->
                        <div @onclick="() => TogglePlayerDetail(player.Id)"
                             class="p-3.5 cursor-pointer select-none">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-3">
                                    <span class="w-8 h-8 rounded-full bg-well2 border border-line2 flex items-center justify-center text-xs font-cond font-extrabold text-ink2 shrink-0">
                                        @(player.JerseyNumber?.ToString() ?? "-")
                                    </span>
                                    <div>
                                        <div class="font-bold text-sm text-ink flex items-center gap-1.5">
                                            <span>@player.FullName</span>
                                            @if (player.Id == CurrentUser.Id)
                                            {
                                                <span class="text-[11px] font-bold px-1.5 py-0.2 rounded bg-well2 text-muted border border-line2">TÚ</span>
                                            }
                                            @if (isSeasonComplete)
                                            {
                                                <span class="text-[11px] font-extrabold px-1.5 py-0.2 rounded bg-okbg text-oktext border border-ok/40">
                                                    ✓ CUBIERTO
                                                </span>
                                            }
                                        </div>
                                        <div class="text-xs text-muted">
                                            @player.Nickname • @player.Position
                                        </div>
                                    </div>
                                </div>

                                <div class="flex items-center gap-2.5">
                                    <div class="text-right">
                                        <div class="font-cond font-extrabold text-sm text-oktext">
                                            @totalPaidByPlayer.ToString("N0") €
                                        </div>
                                        <div class="text-xs font-medium @(isSeasonComplete ? "text-oktext" : "text-warntext")">
                                            @(isSeasonComplete ? "Temporada al día" : $"Faltan {remaining:N0} €")
                                        </div>
                                    </div>

                                    <span class="text-faint text-xs font-bold transition-transform @(isExpanded ? "rotate-90 text-ink" : "")">
                                        ›
                                    </span>
                                </div>
                            </div>

                            <!-- Progress Bar for Season Fee -->
                            <div class="mt-2.5 flex items-center gap-2">
                                <div class="flex-1 bg-well rounded-full h-1.5 overflow-hidden border border-line">
                                    <div class="h-full @(isSeasonComplete ? "bg-ok" : "bg-warn") transition-all duration-300" style="width: @percent%"></div>
                                </div>
                                <span class="text-xs font-cond text-muted font-bold shrink-0">@percent%</span>
                            </div>
                        </div>

                        <!-- Expanded Payments Detail for this Player -->
                        @if (isExpanded)
                        {
                            <div class="p-3 bg-well border-t border-line space-y-2 text-xs">
                                <div class="flex items-center justify-between text-xs font-bold text-muted px-1">
                                    <span>Detalle de pagos recibidos:</span>
                                    @if (IsAdmin)
                                    {
                                        <button @onclick="() => OnOpenDirectPayment.InvokeAsync(player.Id)"
                                                class="text-xs font-extrabold text-oktext hover:text-ok flex items-center gap-1">
                                            <span>+</span> Cargar pago a este jugador
                                        </button>
                                    }
                                </div>

                                @if (!playerPayments.Any())
                                {
                                    <div class="p-3 text-center text-faint text-xs italic bg-surface rounded-lg">
                                        Aún no tiene pagos registrados por el tesorero.
                                    </div>
                                }
                                else
                                {
                                    <div class="space-y-1.5">
                                        @foreach (var p in playerPayments)
                                        {
                                            <div class="p-2 bg-surface border border-line rounded-lg flex items-center justify-between text-xs">
                                                <div>
                                                    <div class="font-bold text-ink text-xs">@p.Concept</div>
                                                    <div class="text-xs text-muted flex items-center gap-1">
                                                        <span>@(p.PaidAt?.ToString("dd/MM/yyyy") ?? "-")</span>
                                                        <span>•</span>
                                                        <span class="text-oktext font-medium">@p.Method</span>
                                                        @if (!string.IsNullOrEmpty(p.Notes))
                                                        {
                                                            <span>• "@p.Notes"</span>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="font-cond font-extrabold text-xs text-ink">
                                                    +@p.Amount.ToString("N2") €
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    <!-- SUB-TAB 2: HISTORIAL CRONOLÓGICO DE COBROS RECIBIDOS -->
    @if (_subTab == "history")
    {
        var allPayments = TeamService.GetPayments().Where(p => p.Status == PaymentStatus.Paid).OrderByDescending(p => p.PaidAt).ToList();

        <div class="space-y-2">
            <div class="flex items-center justify-between text-xs text-muted px-1">
                <span>Cobros asentados por el tesorero:</span>
                <span class="font-bold text-ink">@allPayments.Count recibidos</span>
            </div>

            @if (!allPayments.Any())
            {
                <div class="p-6 bg-surface border border-line rounded-xl text-center text-faint text-xs">
                    No hay cobros registrados todavía.
                </div>
            }
            else
            {
                <div class="space-y-2">
                    @foreach (var pay in allPayments)
                    {
                        var player = pay.IsPlayerPayment ? TeamService.GetProfiles().FirstOrDefault(p => p.Id == pay.PlayerId) : null;
                        var receiver = !string.IsNullOrEmpty(pay.ReceivedByPlayerId) ? TeamService.GetProfileById(pay.ReceivedByPlayerId) : null;

                        <div class="bg-surface border border-line rounded-xl p-3 flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-lg @(pay.IsPlayerPayment ? "bg-okbg border border-ok/40 text-oktext" : "bg-clubbg border border-club/40 text-clubtext") flex items-center justify-center font-bold text-xs shrink-0">
                                    @(pay.IsPlayerPayment ? "✓" : "💰")
                                </div>
                                <div>
                                    @if (pay.IsPlayerPayment)
                                    {
                                        <div class="font-bold text-sm text-ink">
                                            @player?.Nickname
                                            <span class="font-normal text-xs text-muted">(@player?.FullName)</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="font-bold text-sm text-ink">@pay.Category</div>
                                    }
                                    <div class="text-xs text-muted">
                                        @pay.Concept • @(pay.PaidAt?.ToString("dd/MM/yyyy") ?? "") • Vía <span class="text-ink2 font-semibold">@pay.Method</span>
                                        @if (receiver != null)
                                        {
                                            <span> • Recibió <span class="text-ink2 font-semibold">@receiver.Nickname</span></span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="flex items-center gap-2.5">
                                <div class="font-cond font-extrabold text-sm text-oktext">
                                    +@pay.Amount.ToString("N2") €
                                </div>
                                @if (IsAdmin)
                                {
                                    @if (_confirmDeletePaymentId == pay.Id)
                                    {
                                        <div class="flex items-center gap-1 text-[11px]">
                                            <span class="text-clubtext font-bold">¿Borrar?</span>
                                            <button type="button" @onclick="() => DeletePayment(pay.Id)"
                                                    class="px-2 py-1 rounded-md bg-club text-white font-bold">Sí</button>
                                            <button type="button" @onclick="() => _confirmDeletePaymentId = null"
                                                    class="px-2 py-1 rounded-md bg-well text-ink font-bold">No</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <button type="button" @onclick="() => OnEditPayment.InvokeAsync(pay)"
                                                class="text-faint hover:text-ink text-xs p-1" title="Editar cobro">
                                            ✎
                                        </button>
                                        <button type="button" @onclick="() => _confirmDeletePaymentId = pay.Id"
                                                class="text-faint hover:text-club text-xs p-1" title="Eliminar cobro (registrado por error)">
                                            ✕
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }

    <!-- SUB-TAB 3: GASTOS DE CAJA -->
    @if (_subTab == "expenses")
    {
        var expenses = TeamService.GetExpenses();

        <div class="space-y-2">
            <div class="flex items-center justify-between text-xs text-muted px-1">
                <span>Salidas de caja del equipo:</span>
                <span class="font-bold text-ink">@expenses.Count gastos</span>
            </div>

            @if (!expenses.Any())
            {
                <div class="p-6 bg-surface border border-line rounded-xl text-center text-faint text-xs">
                    No hay gastos registrados todavía en la caja del club.
                </div>
            }
            else
            {
                <div class="space-y-2">
                    @foreach (var exp in expenses)
                    {
                        var payer = !string.IsNullOrEmpty(exp.PaidBy) ? TeamService.GetProfileById(exp.PaidBy) : null;

                        <div class="bg-surface border border-line rounded-xl p-3.5 flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-9 h-9 rounded-lg bg-well2 border border-line2 flex items-center justify-center text-sm shrink-0">
                                    🧾
                                </div>
                                <div>
                                    <div class="font-bold text-sm text-ink">@exp.Concept</div>
                                    <div class="text-xs text-muted">
                                        @exp.ExpenseDate.ToString("dd/MM/yyyy") • @exp.Category
                                        @if (payer != null)
                                        {
                                            <span> • Pagó <span class="text-ink2 font-semibold">@payer.Nickname</span></span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(exp.Notes))
                                    {
                                        <div class="text-[11px] text-faint italic mt-0.5">"@exp.Notes"</div>
                                    }
                                </div>
                            </div>

                            <div class="flex items-center gap-2.5">
                                <div class="font-extrabold text-sm font-cond text-clubtext">
                                    -@exp.Amount.ToString("N2") €
                                </div>
                                @if (IsAdmin)
                                {
                                    @if (_confirmDeleteExpenseId == exp.Id)
                                    {
                                        <div class="flex items-center gap-1 text-[11px]">
                                            <span class="text-clubtext font-bold">¿Borrar?</span>
                                            <button type="button" @onclick="() => DeleteExpense(exp.Id)"
                                                    class="px-2 py-1 rounded-md bg-club text-white font-bold">Sí</button>
                                            <button type="button" @onclick="() => _confirmDeleteExpenseId = null"
                                                    class="px-2 py-1 rounded-md bg-well text-ink font-bold">No</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <button type="button" @onclick="() => OnEditExpense.InvokeAsync(exp)"
                                                class="text-faint hover:text-ink text-xs p-1" title="Editar gasto">
                                            ✎
                                        </button>
                                        <button type="button" @onclick="() => _confirmDeleteExpenseId = exp.Id"
                                                class="text-faint hover:text-club text-xs p-1" title="Eliminar gasto">
                                            ✕
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }

    <!-- SUB-TAB 4: PRESUPUESTO ANUAL ESTIMADO POR CATEGORÍA -->
    @if (_subTab == "budget")
    {
        var budget = TeamService.GetExpenseBudget();
        var allExpenses = TeamService.GetExpenses();
        var totalBudget = budget.Values.Sum();
        var totalSpent = allExpenses.Sum(e => e.Amount);

        <div class="space-y-3">
            <div class="bg-well p-3.5 rounded-xl border border-line flex items-center justify-between gap-2">
                <div>
                    <div class="text-xs text-muted font-bold uppercase tracking-wider">Presupuesto Anual Estimado</div>
                    <div class="text-sm font-extrabold text-ink">
                        Gastado: <span class="text-clubtext">@totalSpent.ToString("N0") €</span>
                        @if (totalBudget > 0)
                        {
                            <span> / @totalBudget.ToString("N0") €</span>
                        }
                    </div>
                </div>
                @if (totalBudget > 0)
                {
                    var totalPct = (int)Math.Min(100, Math.Round(100.0m * totalSpent / totalBudget));
                    <div class="font-cond font-extrabold text-2xl @(totalPct >= 100 ? "text-club" : totalPct >= 80 ? "text-warntext" : "text-oktext")">
                        @totalPct%
                    </div>
                }
            </div>

            <p class="text-[11px] text-faint px-1 m-0">Estimación de gasto por categoría para la temporada; se compara contra lo ya cargado en Gastos.</p>

            @if (IsAdmin)
            {
            <button type="button" @onclick="ShareBudgetWhatsApp"
                    class="w-full h-10 rounded-[10px] bg-ok hover:bg-okdeep text-white text-xs font-extrabold transition flex items-center justify-center gap-2 shadow-sm">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.5 8.5 0 0 1-12.6 7.4L3 21l2.1-5.4A8.5 8.5 0 1 1 21 11.5z"></path></svg>
                <span>Compartir Ejecución del Presupuesto por WhatsApp</span>
            </button>
            }

            <div class="space-y-2">
                @foreach (var cat in ExpenseCategories)
                {
                    var spent = allExpenses.Where(e => e.Category == cat).Sum(e => e.Amount);
                    var budgeted = budget.TryGetValue(cat, out var b) ? b : 0;
                    var pct = budgeted > 0 ? (int)Math.Min(150, Math.Round(100.0m * spent / budgeted)) : 0;
                    var isEditing = IsAdmin && _editingBudgetCategory == cat;

                    <div class="bg-surface border border-line rounded-xl p-3.5 space-y-2">
                        <div class="flex items-center justify-between gap-2">
                            <span class="font-bold text-sm text-ink shrink-0">@cat</span>
                            @if (isEditing)
                            {
                                <div class="flex items-center gap-1.5">
                                    <input @bind="_editingBudgetAmount" type="number" step="10" min="0"
                                           class="w-24 bg-well border border-line2 rounded-lg px-2 py-1 text-ink font-cond font-bold text-right focus:border-club focus:outline-none" />
                                    <span class="text-xs text-muted">€</span>
                                    <button type="button" @onclick="SaveBudgetCategory" class="text-oktext hover:text-ok text-xs font-bold px-1" title="Guardar">✓</button>
                                    <button type="button" @onclick="() => _editingBudgetCategory = null" class="text-faint hover:text-ink text-xs px-1" title="Cancelar">✕</button>
                                </div>
                            }
                            else
                            {
                                <div class="flex items-center gap-2 shrink-0">
                                    <span class="text-xs text-muted">
                                        <span class="font-bold text-ink font-cond">@spent.ToString("N0") €</span>
                                        @(budgeted > 0 ? $" / {budgeted:N0} €" : " · sin presupuestar")
                                    </span>
                                    @if (IsAdmin)
                                    {
                                        <button type="button" @onclick="() => StartEditBudget(cat, budgeted)"
                                                class="text-faint hover:text-ink text-xs p-0.5" title="Editar presupuesto">
                                            ✎
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                        @if (budgeted > 0)
                        {
                            <div class="flex items-center gap-2">
                                <div class="flex-1 bg-well rounded-full h-1.5 overflow-hidden border border-line">
                                    <div class="h-full @(pct >= 100 ? "bg-club" : pct >= 80 ? "bg-warn" : "bg-ok") transition-all duration-300" style="width: @(Math.Min(100, pct))%"></div>
                                </div>
                                <span class="text-xs font-cond text-muted font-bold shrink-0">@pct%</span>
                            </div>
                        }
                        @if (budgeted > 0 && totalBudget > 0)
                        {
                            var sharePct = (int)Math.Round(100.0m * budgeted / totalBudget);
                            <div class="text-[11px] text-faint m-0">@sharePct% del presupuesto total estimado</div>
                        }
                    </div>
                }
            </div>
        </div>
    }

</div>

@code {
    [Parameter] public EventCallback<string?> OnOpenDirectPayment { get; set; }
    [Parameter] public EventCallback<Payment> OnEditPayment { get; set; }
    [Parameter] public EventCallback OnAddExpense { get; set; }
    [Parameter] public EventCallback<TeamExpense> OnEditExpense { get; set; }

    private static readonly string[] ExpenseCategories = { "Árbitros", "Campos", "Material", "Tercer Tiempo", "Inscripción", "Sanciones", "Fichas", "Otros" };
    private string? _editingBudgetCategory = null;
    private decimal _editingBudgetAmount = 0;

    private void StartEditBudget(string category, decimal current)
    {
        _editingBudgetCategory = category;
        _editingBudgetAmount = current;
    }

    private async Task SaveBudgetCategory()
    {
        if (_editingBudgetCategory == null) return;
        var budget = TeamService.GetExpenseBudget();
        if (_editingBudgetAmount <= 0) budget.Remove(_editingBudgetCategory);
        else budget[_editingBudgetCategory] = _editingBudgetAmount;
        await TeamService.SaveExpenseBudgetAsync(budget);
        _editingBudgetCategory = null;
    }

    private string _subTab = "players"; // "players", "history", "expenses", "budget"
    private string? _expandedPlayerId = null;
    private string? _confirmDeletePaymentId = null;
    private string? _confirmDeleteExpenseId = null;

    private async Task DeletePayment(string paymentId)
    {
        _confirmDeletePaymentId = null;
        await TeamService.DeletePaymentAsync(paymentId);
    }

    private async Task DeleteExpense(string expenseId)
    {
        _confirmDeleteExpenseId = null;
        await TeamService.DeleteExpenseAsync(expenseId);
    }

    private UserProfile CurrentUser => TeamService.GetCurrentUser();
    private bool IsAdmin => CurrentUser.Role == UserRole.Admin || CurrentUser.Role == UserRole.Treasurer;

    private void TogglePlayerDetail(string playerId)
    {
        if (_expandedPlayerId == playerId)
            _expandedPlayerId = null;
        else
            _expandedPlayerId = playerId;
    }

    private async Task ShareTreasuryWhatsApp()
    {
        var balance = TeamService.GetTeamBalance();
        var totalIn = TeamService.GetPayments().Where(p => p.Status == PaymentStatus.Paid).Sum(p => p.Amount);
        var totalOut = TeamService.GetExpenses().Sum(e => e.Amount);
        var fee = TeamService.GetClubSettings().SeasonFeePerPlayer;
        var profiles = TeamService.GetProfiles().Where(p => p.CountsForSeasonFee).ToList();
        var allPayments = TeamService.GetPayments().Where(p => p.Status == PaymentStatus.Paid).ToList();

        var totalPlayerIn = allPayments.Where(p => p.IsPlayerPayment).Sum(p => p.Amount);
        var otherIncomeTotal = allPayments.Where(p => !p.IsPlayerPayment).Sum(p => p.Amount);
        var fullyPaidCount = profiles.Count(p => allPayments.Where(x => x.PlayerId == p.Id).Sum(x => x.Amount) >= fee);
        var totalSeasonTarget = fee * profiles.Count;
        var percentCollected = totalSeasonTarget > 0 ? Math.Round(100.0m * totalPlayerIn / totalSeasonTarget, 1) : 0;

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("💶 *BALANCE DE CAJA · ATLÈTIC POBLENOU*");
        sb.AppendLine($"📅 *Informe al:* {DateTime.Now:dd/MM/yyyy}");
        sb.AppendLine();
        sb.AppendLine($"💰 *Saldo Disponible:* {balance:N2} €");
        sb.AppendLine($"📥 *Total Recaudado:* +{totalIn:N2} €");
        sb.AppendLine($"📤 *Total Gastos de Caja:* −{totalOut:N2} €");
        sb.AppendLine();
        sb.AppendLine($"🎯 *Cuota Temporada ({fee:N0} €/jugador):*");
        sb.AppendLine($"• {fullyPaidCount} de {profiles.Count} jugadores con cuota completa");
        sb.AppendLine($"• Progreso anual: {percentCollected}% cubierto");
        if (otherIncomeTotal > 0)
        {
            sb.AppendLine($"• Otros ingresos (remanente, patrocinios, etc.): +{otherIncomeTotal:N2} €");
        }
        sb.AppendLine();
        sb.AppendLine("📋 *Transparencia total:* Cada compañero puede consultar sus recibos individuales en la app.");
        sb.AppendLine("🔴⚪ *¡Força Poblenou!*");

        var text = sb.ToString();
        var url = $"https://wa.me/?text={Uri.EscapeDataString(text)}";
        await JS.InvokeVoidAsync("open", url, "_blank");
    }

    /// <summary>Mismo orden que la lista de "Aportes" (por dorsal), con lo que aportó cada uno hasta ahora.</summary>
    private async Task SharePlayerContributionsWhatsApp()
    {
        var profiles = TeamService.GetProfiles().Where(p => p.CountsForSeasonFee).ToList();
        var allPaidPayments = TeamService.GetPayments().Where(p => p.Status == PaymentStatus.Paid).ToList();
        var seasonName = TeamService.GetClubSettings().SeasonName;
        var seasonFee = TeamService.GetClubSettings().SeasonFeePerPlayer;

        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"💶 *PAGOS TEMPORADA {seasonName}*");
        sb.AppendLine();

        var i = 1;
        foreach (var player in profiles)
        {
            var total = allPaidPayments.Where(p => p.PlayerId == player.Id).Sum(p => p.Amount);
            var mark = total >= seasonFee ? " ✅" : "";
            sb.AppendLine($"{i}. {player.Nickname} - {total:N0}€{mark}");
            i++;
        }

        var text = sb.ToString();
        var url = $"https://wa.me/?text={Uri.EscapeDataString(text)}";
        await JS.InvokeVoidAsync("open", url, "_blank");
    }

    /// <summary>Cuánto recibió cada persona autorizada este año, y qué se pagó (gastos del año, con la
    /// observación entre paréntesis cuando la tiene, típicamente en "Otros").</summary>
    private async Task ShareCajaWhatsApp()
    {
        var year = DateTime.Now.Year;
        var receivers = TeamService.GetProfiles().Where(p => p.CanReceivePayments).ToList();
        var allPaid = TeamService.GetPayments().Where(p => p.Status == PaymentStatus.Paid && p.PaidAt?.Year == year).ToList();
        var expenses = TeamService.GetExpenses().Where(e => e.ExpenseDate.Year == year).ToList();

        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"💶 *CAJA {year}*");
        sb.AppendLine();
        foreach (var r in receivers)
        {
            var total = allPaid.Where(p => p.ReceivedByPlayerId == r.Id).Sum(p => p.Amount);
            sb.AppendLine($"{r.Nickname} {total:N0}€");
        }
        sb.AppendLine();
        sb.AppendLine("*Pagado*");
        foreach (var e in expenses)
        {
            var noteSuffix = !string.IsNullOrWhiteSpace(e.Notes) ? $" ({e.Notes})" : "";
            sb.AppendLine($"{e.Amount:N0}€ {e.Category}{noteSuffix}");
        }

        var text = sb.ToString();
        var url = $"https://wa.me/?text={Uri.EscapeDataString(text)}";
        await JS.InvokeVoidAsync("open", url, "_blank");
    }

    /// <summary>Ejecución del presupuesto anual: solo categorías con algo presupuestado.</summary>
    private async Task ShareBudgetWhatsApp()
    {
        var budget = TeamService.GetExpenseBudget();
        var expenses = TeamService.GetExpenses();

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("📊 *PRESUPUESTO ANUAL · EJECUCIÓN*");
        sb.AppendLine();

        decimal totalSpent = 0, totalBudget = 0;
        foreach (var cat in ExpenseCategories)
        {
            if (!budget.TryGetValue(cat, out var budgeted) || budgeted <= 0) continue;
            var spent = expenses.Where(e => e.Category == cat).Sum(e => e.Amount);
            totalSpent += spent;
            totalBudget += budgeted;
            var pct = Math.Round(100.0m * spent / budgeted, 0);
            sb.AppendLine($"{cat}: {spent:N0}€ / {budgeted:N0}€ ({pct}%)");
        }

        sb.AppendLine();
        var totalPct = totalBudget > 0 ? Math.Round(100.0m * totalSpent / totalBudget, 0) : 0;
        sb.AppendLine($"*Total: {totalSpent:N0}€ / {totalBudget:N0}€ ({totalPct}%)*");

        var text = sb.ToString();
        var url = $"https://wa.me/?text={Uri.EscapeDataString(text)}";
        await JS.InvokeVoidAsync("open", url, "_blank");
    }
}
