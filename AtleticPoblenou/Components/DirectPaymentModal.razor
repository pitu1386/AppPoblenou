@inject ITeamDataService TeamService

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate-in fade-in duration-150">
        <div class="bg-surface border border-line2 w-full max-w-md rounded-xl p-5 shadow-xl space-y-4">

            <div class="flex items-center justify-between border-b border-line pb-3">
                <div class="flex items-center gap-2">

                    <div>
                        <h3 class="font-extrabold text-ink text-base">Registrar Cobro Recibido</h3>
                        <p class="text-xs text-warntext">Acción exclusiva del Tesorero</p>
                    </div>
                </div>
                <button @onclick="Close" class="w-8 h-8 rounded-full bg-well2 flex items-center justify-center text-muted hover:text-ink">
                    ✕
                </button>
            </div>

            <div class="space-y-3 text-xs">
                <!-- Select Player -->
                <div>
                    <label class="font-bold text-ink2 block mb-1">Jugador que realizó el pago</label>
                    <select @bind="_selectedPlayerId" class="w-full bg-well border border-line2 rounded-lg px-3 py-2.5 text-ink font-medium focus:border-club focus:outline-none">
                        @foreach (var p in TeamService.GetProfiles())
                        {
                            <option value="@p.Id">@p.FullName (@p.Nickname) - #@(p.JerseyNumber?.ToString() ?? "-")</option>
                        }
                    </select>
                </div>

                <!-- Amount -->
                <div>
                    <label class="font-bold text-ink2 block mb-1">Importe Recibido (€)</label>
                    <div class="relative">
                        <input @bind="_amount" type="number" step="0.50" min="1"
                               class="w-full bg-well border border-line2 rounded-lg pl-4 pr-10 py-2.5 text-ink font-cond text-lg font-extrabold focus:border-club focus:outline-none" />
                        <span class="absolute right-3 top-3 text-muted font-bold text-sm">€</span>
                    </div>
                    <!-- Quick Amount Chips -->
                    <div class="flex gap-1.5 mt-1.5 flex-wrap">
                        <button type="button" @onclick="() => SelectQuickAmount(10)" class="px-2.5 py-1 rounded-lg bg-well2 text-xs font-bold text-ink2 hover:bg-well2">10 €</button>
                        <button type="button" @onclick="() => SelectQuickAmount(20)" class="px-2.5 py-1 rounded-lg bg-well2 text-xs font-bold text-ink2 hover:bg-well2">20 €</button>
                        <button type="button" @onclick="() => SelectQuickAmount(50)" class="px-2.5 py-1 rounded-lg bg-well2 text-xs font-bold text-ink2 hover:bg-well2">50 €</button>
                        <button type="button" @onclick='() => SelectQuickAmount(100, "1/2 Temporada")'
                                class="px-2.5 py-1 rounded-lg bg-okbg border border-ok/40 text-xs font-extrabold text-oktext hover:bg-okbg transition">
                            100 €
                        </button>
                        <button type="button" @onclick='() => SelectQuickAmount(200, "Temporada Completa")'
                                class="px-2.5 py-1 rounded-lg bg-okbg border border-ok/40 text-xs font-extrabold text-oktext hover:bg-okbg transition">
                            200 € (Total)
                        </button>
                    </div>
                </div>

                <!-- Concept -->
                <div>
                    <label class="font-bold text-ink2 block mb-1">Concepto</label>
                    <input @bind="_concept" type="text" placeholder="Ej: Cuota Temporada, Octubre, etc."
                           class="w-full bg-well border border-line2 rounded-lg px-3 py-2 text-ink font-medium focus:border-club focus:outline-none" />
                    <!-- Quick Concept Chips -->
                    <div class="flex gap-1.5 mt-1.5 flex-wrap">
                        <button type="button" @onclick='() => _concept = "Temporada Completa"' class="px-2 py-0.5 rounded bg-okbg border border-ok/40 text-xs text-oktext font-bold hover:text-ink">Temporada Completa</button>
                        <button type="button" @onclick='() => _concept = "1/2 Temporada"' class="px-2 py-0.5 rounded bg-well2 text-xs text-ink2 hover:text-ink">1/2 Temporada</button>
                        <button type="button" @onclick='() => _concept = "Cuota Mensual"' class="px-2 py-0.5 rounded bg-well2 text-xs text-ink2 hover:text-ink">Cuota Mensual</button>
                        <button type="button" @onclick='() => _concept = "Ficha de Liga"' class="px-2 py-0.5 rounded bg-well2 text-xs text-ink2 hover:text-ink">Ficha Liga</button>
                    </div>
                </div>

                <!-- Payment Method -->
                <div>
                    <label class="font-bold text-ink2 block mb-1">Método de Cobro</label>
                    <div class="grid grid-cols-3 gap-2">
                        <button type="button" @onclick="() => _method = PaymentMethod.Bizum"
                                class="py-2 rounded-lg font-bold border transition @(_method == PaymentMethod.Bizum ? "bg-ok text-white border-ok" : "bg-well text-ink2 border-line2")">
                            Bizum
                        </button>
                        <button type="button" @onclick="() => _method = PaymentMethod.Cash"
                                class="py-2 rounded-lg font-bold border transition @(_method == PaymentMethod.Cash ? "bg-ok text-white border-ok" : "bg-well text-ink2 border-line2")">
                            Efectivo
                        </button>
                        <button type="button" @onclick="() => _method = PaymentMethod.Transfer"
                                class="py-2 rounded-lg font-bold border transition @(_method == PaymentMethod.Transfer ? "bg-ok text-white border-ok" : "bg-well text-ink2 border-line2")">
                            Transf.
                        </button>
                    </div>
                </div>

                <!-- Date -->
                <div>
                    <label class="font-bold text-ink2 block mb-1">Fecha del Cobro</label>
                    <input @bind="_paymentDate" type="date"
                           class="w-full bg-well border border-line2 rounded-lg px-3 py-2 text-ink font-medium focus:border-club focus:outline-none" />
                </div>
            </div>

            <div class="flex gap-2 pt-2 border-t border-line">
                <button @onclick="Close" class="flex-1 py-2.5 bg-well2 hover:bg-well2 text-ink2 font-bold rounded-lg text-xs transition">
                    Cancelar
                </button>
                <button @onclick="SavePayment" class="flex-1 py-2.5 bg-ok hover:bg-okdeep text-white font-extrabold rounded-lg text-xs transition">
                    Asentar Cobro
                </button>
            </div>

        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public string? PreselectedPlayerId { get; set; }

    private string _selectedPlayerId = "";
    private decimal _amount = 20.00m;
    private string _concept = "Cuota Octubre";
    private PaymentMethod _method = PaymentMethod.Bizum;
    private DateTime _paymentDate = DateTime.Today;

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(PreselectedPlayerId))
        {
            _selectedPlayerId = PreselectedPlayerId;
        }
        else if (string.IsNullOrEmpty(_selectedPlayerId) && TeamService.GetProfiles().Any())
        {
            _selectedPlayerId = TeamService.GetProfiles().First().Id;
        }
    }

    private void SelectQuickAmount(decimal amount, string defaultConcept = "")
    {
        _amount = amount;
        if (!string.IsNullOrEmpty(defaultConcept))
        {
            _concept = defaultConcept;
        }
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task SavePayment()
    {
        if (string.IsNullOrWhiteSpace(_selectedPlayerId) || _amount <= 0 || string.IsNullOrWhiteSpace(_concept)) return;

        await TeamService.AddPaymentAsync(_selectedPlayerId, _concept, _amount, _method, _paymentDate);
        await Close();
    }
}

