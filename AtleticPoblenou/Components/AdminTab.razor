@inject ITeamDataService TeamService

<div class="space-y-4 pb-20">

    <div class="px-0.5 pb-1">
        <h2 class="font-cond font-extrabold text-[26px] leading-none text-ink m-0">Administración</h2>
        <p class="text-[13px] font-medium text-muted m-0 mt-1">Configuración del club, gestión de plantilla y avisos</p>
    </div>

    <!-- SUB-PESTAÑAS DE ADMINISTRACIÓN -->
    <div class="apn-tabs">
        <button type="button" @onclick='() => _subTab = "plantilla"' class="apn-tab @(_subTab == "plantilla" ? "active" : "")">
            Plantilla
        </button>
        <button type="button" @onclick='() => _subTab = "club"' class="apn-tab @(_subTab == "club" ? "active" : "")">
            Club y Liga
        </button>
        <button type="button" @onclick='() => _subTab = "comunicados"' class="apn-tab @(_subTab == "comunicados" ? "active" : "")">
            Comunicados
        </button>
    </div>

    @{
        var allProfiles = TeamService.GetProfiles();
        var activeCount = allProfiles.Count(p => p.IsActive);
        var deactivatedCount = allProfiles.Count(p => !p.IsActive);
        var allAnn = TeamService.GetAllAnnouncements();
        var archCount = allAnn.Count(a => !a.IsActive);
        var clubSettings = TeamService.GetClubSettings();
    }

    <!-- SUB-TAB 1: PLANTILLA Y MIEMBROS -->
    @if (_subTab == "plantilla")
    {
        <div class="space-y-3">
            <!-- Administrar Roles -->
            <button type="button" @onclick="() => _showRolesModal = true"
                    class="w-full p-4 bg-surface hover:bg-well border border-line rounded-xl flex items-center justify-between text-left transition group shadow-xs">
                <div class="flex items-center gap-3.5">
                    <div class="w-11 h-11 rounded-xl bg-infobg border border-info/30 text-infotext flex items-center justify-center text-xl shrink-0 group-hover:scale-105 transition">
                        👥
                    </div>
                    <div>
                        <div class="font-bold text-sm text-ink">Administrar Roles y Permisos</div>
                        <div class="text-xs text-muted">Asignar DT, Delegado, Tesorero, Capitán o Jugador</div>
                    </div>
                </div>
                <span class="text-faint text-lg font-bold group-hover:translate-x-0.5 transition">›</span>
            </button>

            <!-- Histórico y Bajas -->
            <button type="button" @onclick="() => _showPlayerHistoryModal = true"
                    class="w-full p-4 bg-surface hover:bg-well border border-line rounded-xl flex items-center justify-between text-left transition group shadow-xs">
                <div class="flex items-center gap-3.5">
                    <div class="w-11 h-11 rounded-xl @(deactivatedCount > 0 ? "bg-red-500/10 border border-red-500/30 text-red-500" : "bg-clubbg border border-club/30 text-clubtext") flex items-center justify-center text-xl shrink-0 group-hover:scale-105 transition">
                        📜
                    </div>
                    <div>
                        <div class="font-bold text-sm text-ink flex items-center gap-2">
                            <span>Histórico & Bajas de Jugadores</span>
                            @if (deactivatedCount > 0)
                            {
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-red-500 text-white">
                                    @deactivatedCount @(deactivatedCount == 1 ? "baja" : "bajas")
                                </span>
                            }
                        </div>
                        <div class="text-xs text-muted">@activeCount jugadores activos · reactivar bajas o editar fichas</div>
                    </div>
                </div>
                <span class="text-faint text-lg font-bold group-hover:translate-x-0.5 transition">›</span>
            </button>

            <!-- Código Secreto de Registro Nuevo Jugador -->
            <div class="p-4 bg-surface rounded-xl border border-line space-y-3 shadow-xs">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="text-lg">🔑</span>
                        <div class="text-xs font-bold text-ink uppercase tracking-wide">Código de Registro</div>
                    </div>
                    <span class="text-[11px] text-muted">Para nuevos jugadores</span>
                </div>

                <div class="p-3 bg-well rounded-lg border border-line2 flex items-center justify-between">
                    <div>
                        <div class="text-[10px] text-muted font-bold uppercase tracking-wider">Código de Equipo</div>
                        <div class="font-cond font-extrabold text-xl text-warntext tracking-wider">
                            @TeamService.GetTeamSecretCode()
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <button type="button" @onclick="GenerateNewCode"
                                class="px-3 py-1.5 bg-well2 hover:bg-well2 text-ink font-bold text-xs rounded-lg transition border border-line2">
                            Regenerar
                        </button>
                        @{
                            var codeText = Uri.EscapeDataString($"¡Hola! Para registrarte en la App de Veteranos del Atlètic Poblenou usa este código de equipo: {TeamService.GetTeamSecretCode()}");
                        }
                        <a href="https://wa.me/?text=@codeText" target="_blank"
                           class="px-3 py-1.5 bg-ok hover:bg-okdeep text-white font-extrabold text-xs rounded-lg transition flex items-center gap-1.5 shadow-xs">
                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.5 8.5 0 0 1-12.6 7.4L3 21l2.1-5.4A8.5 8.5 0 1 1 21 11.5z"></path></svg>
                            Compartir WhatsApp
                        </a>
                    </div>
                </div>

                @if (_codeJustGenerated)
                {
                    <div class="text-xs text-oktext font-bold flex items-center gap-1">
                        <span>✓</span> ¡Nuevo código generado y guardado correctamente!
                    </div>
                }
            </div>
        </div>
    }

    <!-- SUB-TAB 2: CLUB Y LIGA -->
    @if (_subTab == "club")
    {
        <div class="space-y-3">
            <!-- Identidad del Club -->
            <button type="button" @onclick="() => _showClubSettingsModal = true"
                    class="w-full p-4 bg-surface hover:bg-well border border-line rounded-xl flex items-center justify-between text-left transition group shadow-xs">
                <div class="flex items-center gap-3.5">
                    <div class="w-11 h-11 rounded-xl bg-clubbg border border-club/30 text-clubtext flex items-center justify-center text-xl shrink-0 group-hover:scale-105 transition">
                        👕
                    </div>
                    <div>
                        <div class="font-bold text-sm text-ink">Identidad y Equipación</div>
                        <div class="text-xs text-muted">Colores de camiseta, campo (@clubSettings.HomeVenueName) y cuota (@clubSettings.SeasonFeePerPlayer €)</div>
                    </div>
                </div>
                <span class="text-faint text-lg font-bold group-hover:translate-x-0.5 transition">›</span>
            </button>

            <!-- Gestión de Temporadas -->
            <button type="button" @onclick="() => _showSeasonModal = true"
                    class="w-full p-4 bg-surface hover:bg-well border border-line rounded-xl flex items-center justify-between text-left transition group shadow-xs">
                <div class="flex items-center gap-3.5">
                    <div class="w-11 h-11 rounded-xl bg-okbg border border-ok/30 text-oktext flex items-center justify-center text-xl shrink-0 group-hover:scale-105 transition">
                        🏁
                    </div>
                    <div>
                        <div class="font-bold text-sm text-ink flex items-center gap-2">
                            <span>Gestión de Temporadas</span>
                            <span class="px-2 py-0.5 rounded text-[10px] font-extrabold bg-okbg text-oktext border border-ok/30">
                                @clubSettings.SeasonName
                            </span>
                        </div>
                        <div class="text-xs text-muted">Cambiar temporada activa, cerrar ciclo y archivar estadísticas</div>
                    </div>
                </div>
                <span class="text-faint text-lg font-bold group-hover:translate-x-0.5 transition">›</span>
            </button>

            <!-- Carga Rápida de Resultados de la Liga -->
            <button type="button" @onclick="() => OnOpenRoundResults.InvokeAsync()"
                    class="w-full p-4 bg-surface hover:bg-well border border-amber-500/30 rounded-xl flex items-center justify-between text-left transition group shadow-xs">
                <div class="flex items-center gap-3.5">
                    <div class="w-11 h-11 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-500 flex items-center justify-center text-xl shrink-0 group-hover:scale-105 transition">
                        ⚡
                    </div>
                    <div>
                        <div class="font-bold text-sm text-ink flex items-center gap-2">
                            <span>Resultados de la Jornada (Liga)</span>
                            <span class="px-1.5 py-0.2 rounded text-[10px] font-bold bg-amber-500/20 text-amber-500 border border-amber-500/30">
                                Rápido
                            </span>
                        </div>
                        <div class="text-xs text-muted">Cargar marcadores de todos los partidos de la fecha para actualizar la tabla</div>
                    </div>
                </div>
                <span class="text-faint text-lg font-bold group-hover:translate-x-0.5 transition">›</span>
            </button>

            <!-- Base de Datos Cloud (Supabase) -->
            @if (TeamService.IsOwnerAdmin(TeamService.GetCurrentUser()))
            {
                <button type="button" @onclick="OnOpenDbModal"
                        class="w-full p-4 bg-surface hover:bg-well border border-line rounded-xl flex items-center justify-between text-left transition group shadow-xs">
                    <div class="flex items-center gap-3.5">
                        <div class="w-11 h-11 rounded-xl bg-infobg border border-info/30 text-infotext flex items-center justify-center text-xl shrink-0 group-hover:scale-105 transition">
                            🐘
                        </div>
                        <div>
                            <div class="font-bold text-sm text-ink flex items-center gap-2">
                                <span>Base de Datos Supabase (PostgreSQL)</span>
                                <span class="px-1.5 py-0.2 rounded text-[10px] font-bold bg-infobg text-infotext border border-info/30">
                                    En la nube
                                </span>
                            </div>
                            <div class="text-xs text-muted">Estado de conexión, tiempo real y sincronización manual</div>
                        </div>
                    </div>
                    <span class="text-faint text-lg font-bold group-hover:translate-x-0.5 transition">›</span>
                </button>
            }
        </div>
    }

    <!-- SUB-TAB 3: COMUNICADOS Y ENCUESTAS -->
    @if (_subTab == "comunicados")
    {
        <div class="space-y-3">
            <!-- Publicar Comunicado -->
            <button type="button" @onclick="OnOpenCreateAnnouncement"
                    class="w-full p-4 bg-surface hover:bg-well border border-line rounded-xl flex items-center justify-between text-left transition group shadow-xs">
                <div class="flex items-center gap-3.5">
                    <div class="w-11 h-11 rounded-xl bg-warnbg border border-warn/30 text-warntext flex items-center justify-center text-xl shrink-0 group-hover:scale-105 transition">
                        📣
                    </div>
                    <div>
                        <div class="font-bold text-sm text-ink">Publicar Nuevo Comunicado</div>
                        <div class="text-xs text-muted">Avisos oficiales, asados de equipo y encuestas con votación</div>
                    </div>
                </div>
                <span class="text-faint text-lg font-bold group-hover:translate-x-0.5 transition">›</span>
            </button>

            <!-- Historial de Comunicados -->
            <button type="button" @onclick="() => _showAnnouncementHistoryModal = true"
                    class="w-full p-4 bg-surface hover:bg-well border border-line rounded-xl flex items-center justify-between text-left transition group shadow-xs">
                <div class="flex items-center gap-3.5">
                    <div class="w-11 h-11 rounded-xl bg-clubbg border border-club/30 text-clubtext flex items-center justify-center text-xl shrink-0 group-hover:scale-105 transition">
                        📢
                    </div>
                    <div>
                        <div class="font-bold text-sm text-ink flex items-center gap-2">
                            <span>Historial de Comunicados</span>
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-well border border-line text-muted">
                                @allAnn.Count @(allAnn.Count == 1 ? "publicación" : "publicaciones")
                            </span>
                            @if (archCount > 0)
                            {
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-amber-500/20 text-amber-600">
                                    @archCount archivados
                                </span>
                            }
                        </div>
                        <div class="text-xs text-muted">Ver votos de encuestas pasadas, desarchivar o reactivar</div>
                    </div>
                </div>
                <span class="text-faint text-lg font-bold group-hover:translate-x-0.5 transition">›</span>
            </button>
        </div>
    }

    <!-- Modales de Administración -->
    <ClubSettingsModal @bind-IsOpen="_showClubSettingsModal" />
    <ManageRolesModal @bind-IsOpen="_showRolesModal" />
    <SeasonManagerModal @bind-IsOpen="_showSeasonModal" />
    <PlayerHistoryModal @bind-IsOpen="_showPlayerHistoryModal" OnOpenPlayerSheet="OnOpenPlayerSheet" />
    <AnnouncementHistoryModal @bind-IsOpen="_showAnnouncementHistoryModal" />

</div>

@code {
    [Parameter] public EventCallback OnCreateMatch { get; set; }
    [Parameter] public EventCallback OnRecordPayment { get; set; }
    [Parameter] public EventCallback OnOpenCreateTeam { get; set; }
    [Parameter] public EventCallback OnOpenCreateAnnouncement { get; set; }
    [Parameter] public EventCallback OnAddExpense { get; set; }
    [Parameter] public EventCallback OnOpenDbModal { get; set; }
    [Parameter] public EventCallback OnOpenRoundResults { get; set; }
    [Parameter] public EventCallback<UserProfile> OnOpenPlayerSheet { get; set; }

    private string _subTab = "plantilla"; // "plantilla", "club", "comunicados"
    private bool _codeJustGenerated = false;
    private bool _showClubSettingsModal = false;
    private bool _showRolesModal = false;
    private bool _showSeasonModal = false;
    private bool _showPlayerHistoryModal = false;
    private bool _showAnnouncementHistoryModal = false;

    private async Task GenerateNewCode()
    {
        await TeamService.GenerateNewTeamCodeAsync();
        _codeJustGenerated = true;
        StateHasChanged();
    }
}
