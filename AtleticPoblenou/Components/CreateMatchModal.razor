@inject ITeamDataService TeamService
@using AtleticPoblenou.Services

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate-in">
        <div class="bg-surface border border-line2 w-full max-w-md rounded-xl p-5 shadow-xl space-y-4">

            <div class="flex items-center justify-between border-b border-line pb-3">
                <div class="flex items-center gap-2">

                    <div>
                        <h3 class="font-extrabold text-ink text-base">@(TargetMatch != null ? "Editar Partido" : "Programar Partido")</h3>
                        <p class="text-xs text-muted">@(TargetMatch?.Status == MatchStatus.Finished ? "Partido jugado • competición, marcador y datos" : "Atletic Poblenou • Canchas y Horarios")</p>
                    </div>
                </div>
                <button @onclick="Close" class="w-8 h-8 rounded-full bg-well2 flex items-center justify-center text-muted hover:text-ink">
                    ✕
                </button>
            </div>

            <div class="space-y-3 text-xs">
                <!-- Competición: Liga / Copa / Amistoso -->
                <div>
                    <label class="font-bold text-ink2 block mb-1">Competición</label>
                    <div class="grid grid-cols-3 gap-1 bg-well p-1 rounded-xl border border-line">
                        @foreach (var k in new[] { MatchKind.Liga, MatchKind.Copa, MatchKind.Amistoso })
                        {
                            <button type="button" @onclick="() => SetKind(k)"
                                    class="py-1.5 rounded-lg font-bold transition @(_kind == k ? "bg-club text-white shadow-xs" : "text-muted hover:text-ink")">
                                @KindLabel(k)
                            </button>
                        }
                    </div>
                    @if (_kind == MatchKind.Amistoso)
                    {
                        <p class="text-[11px] text-muted mt-1">El amistoso se ve en el fixture pero no cuenta para ninguna tabla.</p>
                    }
                    else if (_kind == MatchKind.Copa)
                    {
                        <p class="text-[11px] text-muted mt-1">La copa tiene su propio fixture y su propia tabla, aparte de la liga.</p>
                    }
                </div>

                @if (_kind != MatchKind.Amistoso)
                {
                    <div>
                        <label class="font-bold text-ink2 block mb-1">Nombre de la competición</label>
                        <input @bind="_competitionName" type="text" placeholder="@(_kind == MatchKind.Copa ? "Ej: Copa Primavera 26/27" : "Ej: Sábados División Honor")"
                               class="w-full bg-well border border-line2 rounded-lg px-3 py-2 text-ink font-medium focus:border-club focus:outline-none" />
                    </div>
                }

                <!-- Select Rival Team from Registered or Custom -->
                <div>
                    <div class="flex items-center justify-between mb-1">
                        <label class="font-bold text-ink2">Equipo Rival</label>
                        <span class="text-xs text-faint">Selecciona o escribe</span>
                    </div>

                    <select @onchange="OnRivalSelected" class="w-full bg-well border border-line2 rounded-lg px-3 py-2.5 text-ink font-medium focus:border-club focus:outline-none mb-1.5">
                        <option value="">-- Elige un equipo de la liga --</option>
                        @foreach (var team in TeamService.GetRivalTeams())
                        {
                            <option value="@team.Id" selected="@(_selectedRivalId == team.Id)">@team.Name (@team.KitDescription)</option>
                        }
                    </select>

                    <input @bind="_opponent" type="text" placeholder="O escribe el nombre del rival..."
                           class="w-full bg-well border border-line2 rounded-lg px-3 py-2 text-ink font-medium focus:border-club focus:outline-none" />

                    @if (_selectedRival != null)
                    {
                        <div class="mt-1.5 p-2 bg-well rounded-lg border border-line flex items-center justify-between">
                            <div class="text-xs text-muted">
                                 Camiseta rival: <strong class="text-ink">@_selectedRival.KitDescription</strong>
                            </div>
                            <div class="w-5 h-5 rounded-md border border-line2 flex overflow-hidden">
                                <div class="w-1/2 h-full" style="background-color: @_selectedRival.PrimaryColorHex"></div>
                                <div class="w-1/2 h-full" style="background-color: @_selectedRival.SecondaryColorHex"></div>
                            </div>
                        </div>

                        @if (_rivalKitWarning != null && _rivalKitWarning.IsClash)
                        {
                            <div class="mt-1.5 p-2.5 rounded-lg border @(_rivalKitWarning.UsingAwayKit ? "bg-warnbg border-warn/40" : "bg-clubbg border-club/40") space-y-1">
                                <div class="flex items-center gap-2 text-xs font-bold @(_rivalKitWarning.UsingAwayKit ? "text-warntext" : "text-clubtext")">
                                    <span>⚠️</span>
                                    <span>@(_rivalKitWarning.UsingAwayKit ? "Coincide con la titular: llevar la alternativa" : "Coincide con la titular y no hay alternativa configurada")</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <div class="w-5 h-5 rounded-md border border-line2 flex overflow-hidden shrink-0">
                                        <div class="w-1/2 h-full" style="background-color: @_rivalKitWarning.PrimaryColorHex"></div>
                                        <div class="w-1/2 h-full" style="background-color: @_rivalKitWarning.SecondaryColorHex"></div>
                                    </div>
                                    <span class="text-xs text-ink2">@_rivalKitWarning.Description</span>
                                </div>
                            </div>
                        }
                    }
                </div>

                <div class="grid @(_kind == MatchKind.Amistoso ? "grid-cols-2" : "grid-cols-3") gap-2">
                    @if (_kind != MatchKind.Amistoso)
                    {
                        <div class="col-span-1">
                            <label class="font-bold text-ink2 block mb-1">@(_kind == MatchKind.Copa ? "Jornada copa" : "Jornada") (#)</label>
                            <input @bind="_round" type="number" min="1" max="38"
                                   class="w-full bg-well border border-line2 rounded-lg px-3 py-2 text-ink font-cond font-bold focus:border-club focus:outline-none text-center" />
                        </div>
                    }
                    <div class="col-span-1">
                        <label class="font-bold text-ink2 block mb-1">Fecha</label>
                        <input @bind="_matchDate" type="date"
                               class="w-full bg-well border border-line2 rounded-lg px-3 py-2 text-ink font-medium focus:border-club focus:outline-none" />
                    </div>
                    <div class="col-span-1">
                        <label class="font-bold text-ink2 block mb-1">Hora</label>
                        <input @bind="_matchTime" type="time"
                               class="w-full bg-well border border-line2 rounded-lg px-3 py-2 text-ink font-medium focus:border-club focus:outline-none" />
                    </div>
                </div>

                <!-- Field & Google Maps URL -->
                <div class="bg-well p-3 rounded-xl border border-line space-y-2">
                    <label class="font-bold text-ink2 block">Cancha / Ubicación</label>

                    @if (_isHome)
                    {
                        <p class="text-[11px] text-muted m-0">Nuestra cancha habitual, configurable en Admin → Club y Liga.</p>
                    }
                    else if (_selectedRival != null && !_selectedRival.HasVenue)
                    {
                        <p class="text-[11px] text-warntext m-0">Este rival todavía no tiene cancha cargada. Escribila acá o guardala en su ficha (Equipos rivales) para que la próxima vez aparezca sola.</p>
                    }
                    else if (_selectedRival != null)
                    {
                        <p class="text-[11px] text-oktext m-0">✓ Cancha del rival, cargada de su ficha.</p>
                    }

                    <div>
                        <input @bind="_locationName" @bind:after="OnLocationChanged" type="text" placeholder="Nombre de la cancha o campo..."
                               class="w-full bg-surface border border-line2 rounded-lg px-3 py-2 text-ink font-medium focus:border-club focus:outline-none" />
                    </div>

                    <div>
                        <label class="text-xs text-muted font-semibold block mb-0.5">Enlace a Google Maps</label>
                        <div class="relative">
                            <input @bind="_locationUrl" type="text" placeholder="https://maps.google.com/?q=..."
                                   class="w-full bg-surface border border-line2 rounded-lg pl-8 pr-3 py-1.5 text-ink font-cond text-xs focus:border-club focus:outline-none" />

                        </div>
                        @if (!string.IsNullOrEmpty(_locationUrl))
                        {
                            <div class="mt-1 flex items-center justify-between text-xs">
                                <span class="text-oktext">✓ Enlace de Maps listo</span>
                                <a href="@_locationUrl" target="_blank" class="text-infotext hover:underline flex items-center gap-0.5">
                                    <span>Abrir en Google Maps</span>
                                    <span>↗</span>
                                </a>
                            </div>
                        }
                    </div>
                </div>

                <div class="flex items-center gap-2">
                    <input @bind="_isHome" @bind:after="ApplyDefaultVenue" type="checkbox" id="isHomeCheck" class="rounded accent-red-600 w-4 h-4" />
                    <label for="isHomeCheck" class="font-semibold text-ink2">Jugamos como local (en casa)</label>
                </div>

                <div>
                    <label class="font-bold text-ink2 block mb-1">Indicaciones para la convocatoria (opcional)</label>
                    <textarea @bind="_notes" rows="2" placeholder="Camiseta titular rojiblanca, estar 30 minutos antes..."
                              class="w-full bg-well border border-line2 rounded-lg px-3 py-2 text-ink font-medium focus:border-club focus:outline-none"></textarea>
                </div>
            </div>

            <div class="flex gap-2 pt-2 border-t border-line">
                <button @onclick="Close" class="flex-1 py-2.5 bg-well2 hover:bg-well2 text-ink2 font-bold rounded-lg text-xs transition">
                    Cancelar
                </button>
                <button @onclick="SaveMatch" class="flex-1 py-2.5 bg-club hover:bg-clubdeep text-white font-extrabold rounded-lg text-xs transition">
                    @(TargetMatch != null ? "Guardar Cambios" : "Crear y Convocar")
                </button>
            </div>

            @if (TargetMatch != null)
            {
                <div class="pt-2 border-t border-line">
                    @if (_showDeleteConfirm)
                    {
                        <div class="p-2.5 bg-red-500/10 border border-red-500/30 rounded-xl flex items-center justify-between text-xs">
                            <span class="text-red-500 font-bold">¿Eliminar este partido del fixture?</span>
                            <div class="flex items-center gap-1.5">
                                <button type="button" @onclick="DeleteMatch"
                                        class="px-2.5 py-1 bg-red-600 hover:bg-red-700 text-white font-bold rounded-lg text-xs transition">
                                    Sí, eliminar
                                </button>
                                <button type="button" @onclick="() => _showDeleteConfirm = false"
                                        class="px-2 py-1 bg-well2 text-ink rounded-lg text-xs transition">
                                    Cancelar
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <button type="button" @onclick="() => _showDeleteConfirm = true"
                                class="w-full py-2 text-xs font-bold text-red-500 hover:text-red-600 hover:bg-red-500/10 rounded-lg transition flex items-center justify-center gap-1">
                            🗑️ Eliminar este partido del fixture
                        </button>
                    }
                </div>
            }

        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public Match? TargetMatch { get; set; }

    private string _opponent = "";
    private string? _selectedRivalId = null;
    private RivalTeam? _selectedRival = null;
    private KitRecommendation? _rivalKitWarning = null;
    private int _round = 5;
    private DateTime _matchDate = DateTime.Today.AddDays(3);
    private TimeOnly _matchTime = new TimeOnly(18, 30);
    private string _locationName = "Camp Agapito Fernández (Poblenou)";
    private string _locationUrl = "https://maps.google.com/?q=Camp+Municipal+de+Futbol+Agapito+Fernandez+Barcelona";
    private MatchKind _kind = MatchKind.Liga;
    private string _competitionName = "";
    private bool _isHome = true;
    private string _notes = "Camiseta titular rojiblanca. Estar 40 minutos antes.";
    private bool _showDeleteConfirm = false;

    private async Task DeleteMatch()
    {
        if (TargetMatch != null)
        {
            await TeamService.DeleteMatchAsync(TargetMatch.Id);
            _showDeleteConfirm = false;
            await Close();
        }
    }

    protected override void OnParametersSet()
    {
        if (IsOpen)
        {
            _showDeleteConfirm = false;
            if (TargetMatch != null)
            {
                _opponent = TargetMatch.Opponent;
                _selectedRivalId = TargetMatch.RivalTeamId;
                _selectedRival = !string.IsNullOrEmpty(_selectedRivalId) ? TeamService.GetRivalTeamById(_selectedRivalId) : null;
                _rivalKitWarning = KitAdvisor.Recommend(TeamService.GetClubSettings(), _selectedRival);
                _kind = TargetMatch.Kind;
                _round = TargetMatch.Round > 0 ? TargetMatch.Round : 1;
                _matchDate = TargetMatch.MatchDate.ToLocalTime().Date;
                _matchTime = TimeOnly.FromDateTime(TargetMatch.MatchDate.ToLocalTime());
                _locationName = TargetMatch.LocationName;
                _locationUrl = TargetMatch.LocationUrl ?? "";
                _competitionName = _kind == MatchKind.Amistoso ? "" : StripRound(TargetMatch.Competition);
                _isHome = TargetMatch.IsHome;
                _notes = TargetMatch.Notes;
            }
            else
            {
                var club = TeamService.GetClubSettings();
                _kind = MatchKind.Liga;
                _competitionName = !string.IsNullOrWhiteSpace(club.LeagueName) ? club.LeagueName : "Liga";
                _locationName = club.HomeVenueName;
                _locationUrl = club.HomeVenueMapsUrl;
                _notes = $"Camiseta {club.KitDescription}. Estar 40 minutos antes.";
            }
        }
    }

    /// <summary>Propone la cancha correcta (la nuestra de local, la del rival de visitante) al crear un
    /// partido nuevo. Editando uno ya guardado no se pisa lo que el usuario haya puesto a mano.</summary>
    private void ApplyDefaultVenue()
    {
        if (TargetMatch != null) return;

        if (_isHome)
        {
            var club = TeamService.GetClubSettings();
            _locationName = club.HomeVenueName;
            _locationUrl = club.HomeVenueMapsUrl;
        }
        else if (_selectedRival != null && _selectedRival.HasVenue)
        {
            _locationName = _selectedRival.VenueName;
            _locationUrl = _selectedRival.VenueMapsUrl;
        }
    }

    private static string KindLabel(MatchKind k) => k switch
    {
        MatchKind.Copa => "Copa",
        MatchKind.Amistoso => "Amistoso",
        _ => "Liga"
    };

    private void SetKind(MatchKind k)
    {
        if (_kind == k) return;
        var club = TeamService.GetClubSettings();
        // Al cambiar de competición proponemos un nombre por defecto si el campo está vacío o traía el de otra.
        var defaults = new[] { !string.IsNullOrWhiteSpace(club.LeagueName) ? club.LeagueName : "Liga", "Copa" };
        if (string.IsNullOrWhiteSpace(_competitionName) || defaults.Contains(_competitionName))
        {
            _competitionName = k == MatchKind.Copa ? "Copa" : (!string.IsNullOrWhiteSpace(club.LeagueName) ? club.LeagueName : "Liga");
        }
        _kind = k;
    }

    private static string StripRound(string competition)
    {
        if (string.IsNullOrEmpty(competition)) return "";
        var i = competition.IndexOf(" · J", StringComparison.Ordinal);
        if (i < 0) i = competition.IndexOf(" - J", StringComparison.Ordinal);
        return i > 0 ? competition[..i].Trim() : competition.Trim();
    }

    private void OnLocationChanged()
    {
        if (string.IsNullOrWhiteSpace(_locationUrl) && !string.IsNullOrWhiteSpace(_locationName))
        {
            _locationUrl = $"https://maps.google.com/?q={Uri.EscapeDataString(_locationName +" Barcelona")}";
        }
    }

    private void OnRivalSelected(ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        _selectedRivalId = id;
        if (!string.IsNullOrEmpty(id))
        {
            _selectedRival = TeamService.GetRivalTeamById(id);
            if (_selectedRival != null)
            {
                _opponent = _selectedRival.Name;
            }
        }
        else
        {
            _selectedRival = null;
        }

        _rivalKitWarning = KitAdvisor.Recommend(TeamService.GetClubSettings(), _selectedRival);

        // Solo se autocompletan notas y cancha al crear un partido nuevo; al editar uno existente no se pisan.
        if (TargetMatch == null)
        {
            _notes = $"Camiseta {_rivalKitWarning.Description}. Estar 40 minutos antes.";
            ApplyDefaultVenue();
        }
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task SaveMatch()
    {
        if (string.IsNullOrWhiteSpace(_opponent)) return;

        DateTime fullDate = _matchDate.Date.Add(_matchTime.ToTimeSpan());

        if (string.IsNullOrWhiteSpace(_locationUrl) && !string.IsNullOrWhiteSpace(_locationName))
        {
            _locationUrl = $"https://maps.google.com/?q={Uri.EscapeDataString(_locationName +" Barcelona")}";
        }

        int round = _kind == MatchKind.Amistoso ? 0 : Math.Max(1, _round);
        string competition = _kind switch
        {
            MatchKind.Amistoso => "Amistoso",
            MatchKind.Copa => string.IsNullOrWhiteSpace(_competitionName) ? "Copa" : _competitionName.Trim(),
            _ => string.IsNullOrWhiteSpace(_competitionName) ? "Liga" : _competitionName.Trim()
        };

        if (TargetMatch != null)
        {
            TargetMatch.IsHome = _isHome;   // primero: define a qué lado van nombre y marcador
            TargetMatch.Opponent = _opponent.Trim();
            TargetMatch.RivalTeamId = _selectedRivalId;
            TargetMatch.Kind = _kind;
            TargetMatch.Round = round;
            TargetMatch.Competition = competition;
            TargetMatch.MatchDate = fullDate;
            TargetMatch.LocationName = _locationName;
            TargetMatch.LocationUrl = _locationUrl;
            TargetMatch.Notes = _notes;

            await TeamService.UpdateMatchDetailsAsync(TargetMatch);
        }
        else
        {
            var match = new Match
            {
                Opponent = _opponent.Trim(),
                RivalTeamId = _selectedRivalId,
                Kind = _kind,
                Round = round,
                MatchDate = fullDate,
                LocationName = _locationName,
                LocationUrl = _locationUrl,
                Competition = competition,
                IsHome = _isHome,
                Notes = _notes,
                Status = MatchStatus.Upcoming
            };

            await TeamService.AddMatchAsync(match);
        }

        await Close();
    }
}
