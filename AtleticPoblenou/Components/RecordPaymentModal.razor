@inject ITeamDataService TeamService

@if (IsOpen && TargetPayment != null)
{
    var player = TeamService.GetProfiles().FirstOrDefault(p => p.Id == TargetPayment.PlayerId);

    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate-in fade-in duration-150">
        <div class="bg-surface border border-line2 w-full max-w-md rounded-xl p-5 shadow-xl space-y-4">

            <div class="flex items-center justify-between border-b border-line pb-3">
                <div>
                    <h3 class="font-extrabold text-ink text-base">Registrar Cobro</h3>
                    <p class="text-xs text-muted">@player?.FullName (@player?.Nickname)</p>
                </div>
                <button @onclick="Close" class="w-8 h-8 rounded-full bg-well2 flex items-center justify-center text-muted hover:text-ink">
                    ✕
                </button>
            </div>

            <div class="bg-well p-3 rounded-xl border border-line flex items-center justify-between">
                <div>
                    <div class="text-xs font-bold text-ink">@TargetPayment.Concept</div>
                    <div class="text-xs text-muted">Pendiente de pago</div>
                </div>
                <div class="text-lg font-extrabold text-ink font-cond">
                    @TargetPayment.Amount.ToString("N2") €
                </div>
            </div>

            <div class="space-y-3 text-xs">
                <div>
                    <label class="font-bold text-ink2 block mb-1">Método de Pago</label>
                    <div class="grid grid-cols-3 gap-2">
                        <button type="button" @onclick="() => _method = PaymentMethod.Bizum"
                                class="py-2 rounded-lg font-bold border transition @(_method == PaymentMethod.Bizum ? "bg-ok text-white border-ok" : "bg-well text-ink2 border-line2")">
                            Bizum
                        </button>
                        <button type="button" @onclick="() => _method = PaymentMethod.Cash"
                                class="py-2 rounded-lg font-bold border transition @(_method == PaymentMethod.Cash ? "bg-ok text-white border-ok" : "bg-well text-ink2 border-line2")">
                            Efectivo
                        </button>
                        <button type="button" @onclick="() => _method = PaymentMethod.Transfer"
                                class="py-2 rounded-lg font-bold border transition @(_method == PaymentMethod.Transfer ? "bg-ok text-white border-ok" : "bg-well text-ink2 border-line2")">
                            Transf.
                        </button>
                    </div>
                </div>

                <div>
                    <label class="font-bold text-ink2 block mb-1">Notas internas (opcional)</label>
                    <input @bind="_notes" type="text" placeholder="Ej: Pagado el sábado después del partido"
                           class="w-full bg-well border border-line2 rounded-lg px-3 py-2 text-ink font-medium focus:border-club focus:outline-none" />
                </div>
            </div>

            <div class="flex gap-2 pt-2">
                <button @onclick="Close" class="flex-1 py-2.5 bg-well2 hover:bg-well2 text-ink2 font-bold rounded-lg text-xs transition">
                    Cancelar
                </button>
                <button @onclick="ConfirmPayment" class="flex-1 py-2.5 bg-ok hover:bg-okdeep text-white font-extrabold rounded-lg text-xs transition">
                    Marcar como Pagado
                </button>
            </div>

        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public Payment? TargetPayment { get; set; }

    private PaymentMethod _method = PaymentMethod.Bizum;
    private string _notes = "";

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task ConfirmPayment()
    {
        if (TargetPayment == null) return;
        await TeamService.MarkPaymentAsPaidAsync(TargetPayment.Id, _method, _notes);
        await Close();
    }
}
