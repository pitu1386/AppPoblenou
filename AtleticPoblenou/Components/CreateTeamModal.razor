@inject ITeamDataService TeamService

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate-in fade-in duration-150">
        <div class="bg-surface border border-line2 w-full max-w-md rounded-xl p-5 shadow-xl space-y-4">

            <div class="flex items-center justify-between border-b border-line pb-3">
                <div class="flex items-center gap-2">

                    <div>
                        <h3 class="font-extrabold text-ink text-base">Cargar Equipo Rival</h3>
                        <p class="text-xs text-muted">Nombre y colores de camiseta</p>
                    </div>
                </div>
                <button @onclick="Close" class="w-8 h-8 rounded-full bg-well2 flex items-center justify-center text-muted hover:text-ink">
                    ✕
                </button>
            </div>

            <div class="space-y-3.5 text-xs">
                <div>
                    <label class="font-bold text-ink2 block mb-1">Nombre del Club / Equipo</label>
                    <input @bind="_name" type="text" placeholder="Ej: Veteranos Sant Martí, CE Júpiter..."
                           class="w-full bg-well border border-line2 rounded-lg px-3 py-2.5 text-ink font-medium focus:border-club focus:outline-none" />
                </div>

                <!-- Colors Section -->
                <div class="bg-well p-3.5 rounded-xl border border-line space-y-3">
                    <div class="font-bold text-ink2 text-xs flex items-center justify-between">
                        <span>Colores de la Camiseta</span>
                        <!-- Live Kit Preview Badge -->
                        <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-surface border border-line2">
                            <span class="text-xs text-muted">Vista:</span>
                            <div class="w-5 h-5 rounded-md border border-line2 flex overflow-hidden">
                                <div class="w-1/2 h-full" style="background-color: @_primaryColor"></div>
                                <div class="w-1/2 h-full" style="background-color: @_secondaryColor"></div>
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="text-xs text-muted block mb-1 font-semibold">Color Principal</label>
                            <div class="flex items-center gap-2 bg-surface p-2 rounded-lg border border-line2">
                                <input @bind="_primaryColor" type="color" class="w-7 h-7 rounded border-none bg-transparent cursor-pointer" />
                                <input @bind="_primaryColor" type="text" class="w-full bg-transparent text-ink font-cond text-xs focus:outline-none" />
                            </div>
                        </div>

                        <div>
                            <label class="text-xs text-muted block mb-1 font-semibold">Color Secundario</label>
                            <div class="flex items-center gap-2 bg-surface p-2 rounded-lg border border-line2">
                                <input @bind="_secondaryColor" type="color" class="w-7 h-7 rounded border-none bg-transparent cursor-pointer" />
                                <input @bind="_secondaryColor" type="text" class="w-full bg-transparent text-ink font-cond text-xs focus:outline-none" />
                            </div>
                        </div>
                    </div>

                    <!-- Preset color palettes -->
                    <div class="flex items-center gap-1.5 flex-wrap pt-1">
                        <span class="text-xs text-faint font-semibold">Paletas habituales:</span>
                        <button type="button" @onclick='() => SetColors("#1E3A8A", "#FFFFFF", "Azul y blanco")' class="px-2 py-0.5 rounded bg-surface border border-line2 text-xs text-infotext hover:bg-well2">Azul/Blanco</button>
                        <button type="button" @onclick='() => SetColors("#1D4ED8", "#B91C1C", "Azulgrana")' class="px-2 py-0.5 rounded bg-surface border border-line2 text-xs text-clubtext hover:bg-well2">Azulgrana</button>
                        <button type="button" @onclick='() => SetColors("#16A34A", "#FFFFFF", "Verde y blanco")' class="px-2 py-0.5 rounded bg-surface border border-line2 text-xs text-oktext hover:bg-well2">Verde/Blanco</button>
                        <button type="button" @onclick='() => SetColors("#FACC15", "#18181B", "Amarillo y negro")' class="px-2 py-0.5 rounded bg-surface border border-line2 text-xs text-warntext hover:bg-well2">Amarillo/Negro</button>
                        <button type="button" @onclick='() => SetColors("#DC2626", "#18181B", "Rojo y negro")' class="px-2 py-0.5 rounded bg-surface border border-line2 text-xs text-clubtext hover:bg-well2">Rojo/Negro</button>
                    </div>
                </div>

                <div>
                    <label class="font-bold text-ink2 block mb-1">Descripción de la indumentaria</label>
                    <input @bind="_kitDescription" type="text" placeholder="Ej: Camiseta azul marino, pantalón blanco"
                           class="w-full bg-well border border-line2 rounded-lg px-3 py-2 text-ink font-medium focus:border-club focus:outline-none" />
                </div>
            </div>

            <div class="flex gap-2 pt-2 border-t border-line">
                <button @onclick="Close" class="flex-1 py-2.5 bg-well2 hover:bg-well2 text-ink2 font-bold rounded-lg text-xs transition">
                    Cancelar
                </button>
                <button @onclick="SaveTeam" class="flex-1 py-2.5 bg-club hover:bg-clubdeep text-white font-extrabold rounded-lg text-xs transition">
                    Guardar Equipo
                </button>
            </div>

        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    private string _name = "";
    private string _primaryColor = "#1E3A8A";
    private string _secondaryColor = "#FFFFFF";
    private string _kitDescription = "Azul marino y blanco";

    private void SetColors(string pri, string sec, string desc)
    {
        _primaryColor = pri;
        _secondaryColor = sec;
        _kitDescription = desc;
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task SaveTeam()
    {
        if (string.IsNullOrWhiteSpace(_name)) return;

        var team = new RivalTeam
        {
            Name = _name.Trim(),
            PrimaryColorHex = _primaryColor,
            SecondaryColorHex = _secondaryColor,
            KitDescription = _kitDescription.Trim()
        };

        await TeamService.AddRivalTeamAsync(team);
        _name = "";
        await Close();
    }
}

