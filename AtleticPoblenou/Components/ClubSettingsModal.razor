@inject ITeamDataService TeamService

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate-in fade-in duration-150">
        <div class="bg-surface border border-line2 w-full max-w-md rounded-xl p-5 shadow-xl space-y-4 max-h-[90vh] overflow-y-auto">

            <div class="flex items-center justify-between border-b border-line pb-3">
                <div class="flex items-center gap-2">

                    <div>
                        <h3 class="font-extrabold text-ink text-base">Identidad de Nuestro Club</h3>
                        <p class="text-xs text-muted">Colores de camiseta y cancha local</p>
                    </div>
                </div>
                <button @onclick="Close" class="w-8 h-8 rounded-full bg-well2 flex items-center justify-center text-muted hover:text-ink">
                    ✕
                </button>
            </div>

            <div class="space-y-4 text-xs">
                <!-- Club Name & Short Name -->
                <div class="grid grid-cols-3 gap-2">
                    <div class="col-span-2">
                        <label class="font-bold text-ink2 block mb-1">Nombre del Equipo</label>
                        <input @bind="_settings.ClubName" type="text"
                               class="w-full bg-well border border-line2 rounded-lg px-3 py-2 text-ink font-medium focus:border-club focus:outline-none" />
                    </div>
                    <div>
                        <label class="font-bold text-ink2 block mb-1">Siglas en Tabla</label>
                        <input @bind="_settings.ShortName" type="text" placeholder="ATºPOBLENOU"
                               class="w-full bg-well border border-line2 rounded-lg px-3 py-2 text-ink font-bold font-cond text-center focus:border-club focus:outline-none" />
                    </div>
                </div>

                <!-- Division & Temporada -->
                <div class="grid grid-cols-3 gap-2">
                    <div class="col-span-2">
                        <label class="font-bold text-ink2 block mb-1">División / Liga</label>
                        <input @bind="_settings.LeagueName" type="text" placeholder="Sábados División Honor"
                               class="w-full bg-well border border-line2 rounded-lg px-3 py-2 text-ink font-medium focus:border-club focus:outline-none" />
                    </div>
                    <div>
                        <label class="font-bold text-ink2 block mb-1">Temporada</label>
                        <input @bind="_settings.SeasonName" type="text" placeholder="TEMP 26/27"
                               class="w-full bg-well border border-line2 rounded-lg px-3 py-2 text-ink font-bold font-cond text-center focus:border-club focus:outline-none" />
                    </div>
                </div>

                <!-- KIT COLORS SECTION -->
                <div class="bg-well p-3.5 rounded-xl border border-line space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="font-bold text-ink">Nuestra Camiseta Titular</span>
                        <!-- Live preview badge -->
                        <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-surface border border-line2">
                            <span class="text-xs text-muted">Vista:</span>
                            <div class="w-5 h-5 rounded-md border border-line2 flex overflow-hidden">
                                <div class="w-1/2 h-full" style="background-color: @_settings.PrimaryColorHex"></div>
                                <div class="w-1/2 h-full" style="background-color: @_settings.SecondaryColorHex"></div>
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="text-xs text-muted block mb-1 font-semibold">Color Principal</label>
                            <div class="flex items-center gap-2 bg-surface p-2 rounded-lg border border-line2">
                                <input @bind="_settings.PrimaryColorHex" type="color" class="w-7 h-7 rounded border-none bg-transparent cursor-pointer" />
                                <input @bind="_settings.PrimaryColorHex" type="text" class="w-full bg-transparent text-ink font-cond text-xs focus:outline-none uppercase" />
                            </div>
                        </div>

                        <div>
                            <label class="text-xs text-muted block mb-1 font-semibold">Color Secundario</label>
                            <div class="flex items-center gap-2 bg-surface p-2 rounded-lg border border-line2">
                                <input @bind="_settings.SecondaryColorHex" type="color" class="w-7 h-7 rounded border-none bg-transparent cursor-pointer" />
                                <input @bind="_settings.SecondaryColorHex" type="text" class="w-full bg-transparent text-ink font-cond text-xs focus:outline-none uppercase" />
                            </div>
                        </div>
                    </div>

                    <div>
                        <label class="text-xs text-muted block mb-1 font-semibold">Descripción de la indumentaria</label>
                        <input @bind="_settings.KitDescription" type="text" placeholder="Ej: Rojiblanca a rayas verticales"
                               class="w-full bg-surface border border-line2 rounded-lg px-3 py-2 text-ink font-medium focus:border-club focus:outline-none" />
                    </div>
                </div>

                <!-- HOME FIELD / CANCHA HABITUAL -->
                <div class="bg-well p-3.5 rounded-xl border border-line space-y-2.5">
                    <div class="flex items-center justify-between">
                        <span class="font-bold text-ink">Nuestra Cancha Local</span>
                        <span class="text-xs text-faint">Canchas de la zona:</span>
                    </div>

                    <!-- Fast field preset chips -->
                    <div class="flex items-center gap-1.5 flex-wrap">
                        <button type="button" @onclick='() => SetPresetField("Camp Municipal Agapito Fernández", "https://maps.google.com/?q=Camp+Municipal+de+Futbol+Agapito+Fernandez+Barcelona")'
                                class="px-2 py-0.5 rounded-lg bg-surface border border-line2 text-xs text-ink2 hover:text-ink hover:border-club transition">
                             Agapito Fernández
                        </button>
                        <button type="button" @onclick='() => SetPresetField("CEM Can Felipa (Poblenou)", "https://maps.google.com/?q=Can+Felipa+Poblenou+Barcelona")'
                                class="px-2 py-0.5 rounded-lg bg-surface border border-line2 text-xs text-ink2 hover:text-ink hover:border-club transition">
                             Can Felipa
                        </button>
                        <button type="button" @onclick='() => SetPresetField("Camp Municipal Menorca", "https://maps.google.com/?q=Camp+Municipal+de+Futbol+Menorca+Barcelona")'
                                class="px-2 py-0.5 rounded-lg bg-surface border border-line2 text-xs text-ink2 hover:text-ink hover:border-club transition">
                             Menorca
                        </button>
                    </div>

                    <div>
                        <label class="text-xs text-muted block mb-1 font-semibold">Nombre de la Cancha / Instalación</label>
                        <input @bind="_settings.HomeVenueName" type="text" placeholder="Camp Municipal Agapito Fernández"
                               class="w-full bg-surface border border-line2 rounded-lg px-3 py-2 text-ink font-medium focus:border-club focus:outline-none" />
                    </div>

                    <div>
                        <label class="text-xs text-muted block mb-1 font-semibold">Link de Google Maps</label>
                        <div class="relative">
                            <input @bind="_settings.HomeVenueMapsUrl" type="text" placeholder="https://maps.google.com/?q=..."
                                   class="w-full bg-surface border border-line2 rounded-lg pl-8 pr-3 py-1.5 text-ink font-cond text-xs focus:border-club focus:outline-none" />

                        </div>
                        @if (!string.IsNullOrEmpty(_settings.HomeVenueMapsUrl))
                        {
                            <div class="mt-1 flex items-center justify-between text-xs">
                                <span class="text-oktext">✓ Link configurado</span>
                                <a href="@_settings.HomeVenueMapsUrl" target="_blank" class="text-infotext hover:underline flex items-center gap-0.5">
                                    <span>Ver en Google Maps</span>
                                    <span>↗</span>
                                </a>
                            </div>
                        }
                    </div>
                </div>

                <!-- SEASON INITIAL FEE / COSTO DE TEMPORADA -->
                <div class="bg-well p-3.5 rounded-xl border border-line space-y-2.5">
                    <div class="flex items-center justify-between">
                        <span class="font-bold text-ink">Costo Inicial de Temporada</span>
                        <span class="text-xs text-warntext font-bold">Por jugador</span>
                    </div>

                    <p class="text-xs text-muted leading-relaxed">
                        Monto total que debe abonar cada jugador para cubrir ficha de liga, arbitrajes, indumentaria y alquiler de canchas.
                    </p>

                    <!-- Presets chips -->
                    <div class="flex items-center gap-1.5 flex-wrap">
                        <button type="button" @onclick="() => _settings.SeasonFeePerPlayer = 100"
                                class="px-2.5 py-1 rounded-lg bg-surface border border-line2 text-xs font-bold text-ink2 hover:text-ink hover:border-ok transition">
                            100 €
                        </button>
                        <button type="button" @onclick="() => _settings.SeasonFeePerPlayer = 150"
                                class="px-2.5 py-1 rounded-lg bg-surface border border-line2 text-xs font-bold text-ink2 hover:text-ink hover:border-ok transition">
                            150 €
                        </button>
                        <button type="button" @onclick="() => _settings.SeasonFeePerPlayer = 180"
                                class="px-2.5 py-1 rounded-lg bg-surface border border-line2 text-xs font-bold text-ink2 hover:text-ink hover:border-ok transition">
                            180 €
                        </button>
                        <button type="button" @onclick="() => _settings.SeasonFeePerPlayer = 200"
                                class="px-2.5 py-1 rounded-lg bg-okbg border border-ok/40 text-xs font-bold text-oktext hover:bg-okbg transition">
                            200 € (Estándar)
                        </button>
                        <button type="button" @onclick="() => _settings.SeasonFeePerPlayer = 250"
                                class="px-2.5 py-1 rounded-lg bg-surface border border-line2 text-xs font-bold text-ink2 hover:text-ink hover:border-ok transition">
                            250 €
                        </button>
                    </div>

                    <div class="relative">
                        <input @bind="_settings.SeasonFeePerPlayer" type="number" step="5" min="0"
                               class="w-full bg-surface border border-line2 rounded-lg pl-4 pr-10 py-2 text-ink font-cond text-base font-extrabold focus:border-club focus:outline-none" />
                        <span class="absolute right-3 top-2 text-muted font-bold text-sm">€</span>
                    </div>
                </div>

                @if (_savedSuccessfully)
                {
                    <div class="p-2.5 bg-okbg border border-ok/40 rounded-lg text-oktext font-bold text-center flex items-center justify-center gap-1.5 animate-in fade-in">
                        <span>✓</span> ¡Configuración del club guardada y aplicada en toda la app!
                    </div>
                }
            </div>

            <div class="flex gap-2 pt-2 border-t border-line">
                <button @onclick="Close" class="flex-1 py-2.5 bg-well2 hover:bg-well2 text-ink2 font-bold rounded-lg text-xs transition">
                    Cancelar
                </button>
                <button @onclick="SaveSettings" class="flex-1 py-2.5 bg-club hover:bg-clubdeep text-white font-extrabold rounded-lg text-xs transition">
                    Guardar Configuración
                </button>
            </div>

        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    private ClubSettings _settings = new();
    private bool _savedSuccessfully = false;

    protected override void OnParametersSet()
    {
        if (IsOpen)
        {
            var current = TeamService.GetClubSettings();
            _settings = new ClubSettings
            {
                ClubName = current.ClubName,
                ShortName = current.ShortName,
                LeagueName = current.LeagueName,
                SeasonName = current.SeasonName,
                PrimaryColorHex = current.PrimaryColorHex,
                SecondaryColorHex = current.SecondaryColorHex,
                KitDescription = current.KitDescription,
                HomeVenueName = current.HomeVenueName,
                HomeVenueMapsUrl = current.HomeVenueMapsUrl,
                SeasonFeePerPlayer = current.SeasonFeePerPlayer,
                TeamSecretCode = current.TeamSecretCode,
                ShowDemoShortcuts = current.ShowDemoShortcuts,
                SeasonHistory = new List<SeasonArchive>(current.SeasonHistory ?? new())
            };
            _savedSuccessfully = false;
        }
    }

    private void SetPresetField(string name, string url)
    {
        _settings.HomeVenueName = name;
        _settings.HomeVenueMapsUrl = url;
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task SaveSettings()
    {
        await TeamService.SaveClubSettingsAsync(_settings);
        _savedSuccessfully = true;
        await Task.Delay(600);
        await Close();
    }
}

